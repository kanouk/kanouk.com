---
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title: string;
	description?: string | null;
	image?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, description, image, content } = Astro.props;
const fullTitle = `${title} — Photos — kanouk.com`;
const isPreviewHost = Astro.url.hostname.endsWith("workers.dev") || Astro.url.hostname === "localhost";
const blogUrl = isPreviewHost ? "/" : "https://blog.kanouk.com";
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: content ? "article" : "website",
	title: fullTitle,
	pageTitle: title,
	description,
	image,
	content,
	seo: { ogImage: image },
	siteName: "Photos — kanouk.com",
});
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f5f2ea" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#151714" media="(prefers-color-scheme: dark)" />
		<title>{fullTitle}</title>
		{description && <meta name="description" content={description} />}
		<EmDashHead page={pageCtx} />
	</head>
	<body class="site site--photos">
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link" href="#photo-main">本文へ移動</a>
		<header class="photo-header">
			<a class="photo-brand" href="/albums"><span>kanouk.com</span><small>Photos</small></a>
			<nav class="site-switcher" aria-label="サイト切り替え">
				<a aria-current="page" href="/albums">写真</a>
				<a href={blogUrl}>ブログ</a>
			</nav>
		</header>
		<main id="photo-main"><slot /></main>
		<footer class="photo-footer">
			<p><span>kanouk.com / Photos</span>インターネットに公開する写真のための場所。</p>
			<a href={blogUrl}>ブログを読む</a>
		</footer>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
