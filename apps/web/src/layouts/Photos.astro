---
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Aperture, Search } from "lucide-astro";
import AdminBar from "../components/AdminBar.astro";
import SiteFooter from "../components/SiteFooter.astro";
import YohakuHead from "../components/YohakuHead.astro";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title: string;
	canonicalPath?: string;
	description?: string | null;
	image?: string | null;
	pageType?: "website" | "collection" | "image" | "video";
	content?: { collection: string; id: string; slug?: string | null };
	/** The album of the photo shown, for the admin bar's organizer link. */
	adminAlbumId?: string | null;
}

const { title, description, image, pageType = "website", content, adminAlbumId, canonicalPath: canonicalOverride } = Astro.props;
const SITE_NAME = "カノログ フォト";
const fullTitle = `${title} — ${SITE_NAME}`;
const isPreviewHost = Astro.url.hostname.endsWith("workers.dev") || ["localhost", "127.0.0.1"].includes(Astro.url.hostname);
const blogUrl = isPreviewHost ? "/" : "https://blog.kanouk.com";
// The blog hosts the admin and its login; the marker cookie only reveals the bar here.
const showAdminBar = Astro.cookies.get("kanouk-admin-bar")?.value === "1";
const adminOrigin = isPreviewHost ? "" : Astro.url.hostname.includes("staging") ? "https://blog-staging.kanouk.com" : "https://blog.kanouk.com";
const searchUrl = isPreviewHost ? "/photo-search" : "/search";
const canonicalPath = canonicalOverride ?? (Astro.url.pathname === "/photo-search" ? "/search" : Astro.url.pathname);
const isSearchPage = Astro.url.pathname === "/photo-search" || Astro.url.pathname === "/search";
const canonical = new URL(canonicalPath, "https://photos.kanouk.com").toString();
const absoluteImage = image ? new URL(image, "https://photos.kanouk.com").toString() : null;
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType,
	title: fullTitle,
	pageTitle: title,
	description,
	canonical,
	image: absoluteImage,
	content,
	seo: { ogImage: absoluteImage },
	siteName: SITE_NAME,
});
---

<!doctype html>
<html lang="ja" class:list={{ "has-admin-bar": showAdminBar }}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<YohakuHead />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
	</head>
	<body class="site site--photos">
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link" href="#photo-main">本文へ移動</a>
		{showAdminBar && <AdminBar mode="photos" content={content} albumId={adminAlbumId} adminOrigin={adminOrigin} />}
		<header class="photo-header">
			<a class="photo-brand" href="/albums" data-astro-prefetch="hover">
				<span class="photo-brand__mark" aria-hidden="true">
					<Aperture size={17} strokeWidth={1.6} />
				</span>
				<span class="photo-brand__copy">{SITE_NAME}</span>
			</a>
			<nav class="site-switcher" aria-label="サイト切り替え">
				<a aria-current={!isSearchPage ? "page" : undefined} href="/albums" data-astro-prefetch="hover">写真</a>
				<a class="photo-search-link" href={searchUrl} data-astro-prefetch="hover" aria-label="写真を検索" aria-current={isSearchPage ? "page" : undefined}>
					<Search size={16} strokeWidth={1.75} aria-hidden="true" />
					<span>検索</span>
				</a>
				<a href={blogUrl}>ブログ</a>
			</nav>
		</header>
		<main id="photo-main"><slot /></main>
		<SiteFooter
			name={SITE_NAME}
			nameHref="/albums"
			groups={[{ label: "写真", links: [{ label: "アルバム一覧", href: "/albums" }, { label: "写真を検索", href: searchUrl }] }]}
			crossSite={{ label: "ブログ", href: blogUrl }}
		/>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
