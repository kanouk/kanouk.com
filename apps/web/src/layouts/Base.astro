---
import { getEmDashCollection, getSiteSettings } from "emdash";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { Images, Search } from "lucide-astro";
import ProfileCard from "../components/ProfileCard.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import YohakuHead from "../components/YohakuHead.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null | false;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical: canonicalProp,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;

const canonical = canonicalProp === false
	? null
	: canonicalProp ?? new URL(Astro.url.pathname, "https://blog.kanouk.com").toString();

const { siteTitle, siteTagline } = resolveBlogSiteIdentity(await getSiteSettings());
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;
const FOOTER_EXCLUDED_PAGE_SLUGS = new Set(["sample_search", "sample-page-nocalog"]);
const pageResult = await getEmDashCollection("pages", {
	status: "published",
	orderBy: { published_at: "desc" },
	limit: 8,
});
if (Astro.cache?.enabled) Astro.cache.set(pageResult.cacheHint);
const pageCandidates = pageResult.entries;
// Preserve imported sample routes, but do not promote theme/demo artifacts in
// the permanent site navigation.
const pages = pageCandidates
	.filter((page) => !FOOTER_EXCLUDED_PAGE_SLUGS.has(page.data.slug || page.id))
	.slice(0, 4);
const isPreviewHost = Astro.url.hostname.endsWith("workers.dev") || Astro.url.hostname === "localhost";
const photosUrl = isPreviewHost ? "/albums" : "https://photos.kanouk.com/albums";
const isLoggedIn = !!Astro.locals.user;
const currentPath = Astro.url.pathname;
const isSearchPage = currentPath === "/search";
const isArticleSurface = !isSearchPage && (
	currentPath === "/" ||
	currentPath.startsWith("/posts") ||
	currentPath.startsWith("/archives") ||
	currentPath.startsWith("/category/") ||
	currentPath.startsWith("/tag/") ||
	currentPath.startsWith("/pages/")
);
const isPostDetail = /^\/posts\/[^/]+\/?$/.test(currentPath);
const hasPageProfileSidebar = currentPath !== "/"
	&& !isPostDetail
	&& (isArticleSurface || isSearchPage);

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<YohakuHead />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
	</head>
	<body class="site site--blog">
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link" href="#main-content">本文へ移動</a>

		<header class="site-header">
			<div class="site-header__inner">
				<a href="/" class="site-brand" aria-label={`${siteTitle} ホーム`} data-astro-prefetch="hover">
					<img
						src="/kanolog-logo.png"
						alt={siteTitle}
						width="900"
						height="200"
						class="site-brand__image"
					/>
				</a>

				<nav class="site-nav" aria-label="主要ナビゲーション">
					<a href="/category/stream" data-astro-prefetch="hover" aria-current={currentPath.startsWith("/category/stream") ? "page" : undefined}>カノログ（雑記）</a>
					<a href="/category/pattern" data-astro-prefetch="hover" aria-current={currentPath.startsWith("/category/pattern") ? "page" : undefined}>パターン大全</a>
					<a href="/category/shortcut" data-astro-prefetch="hover" aria-current={currentPath.startsWith("/category/shortcut") ? "page" : undefined}>ショートカット</a>
					<a href="/pages/artcert" data-astro-prefetch="hover" aria-current={currentPath.startsWith("/pages/artcert") ? "page" : undefined}>美術検定 対策問題</a>
				</nav>

				<div class="site-tools">
					<a href={photosUrl} class="site-utility-link"><Images size={15} strokeWidth={1.7} aria-hidden="true" /><span>写真</span></a>
					<a href="/search" class="site-utility-link" data-astro-prefetch="hover" aria-current={isSearchPage ? "page" : undefined}><Search size={15} strokeWidth={1.7} aria-hidden="true" /><span>検索</span></a>
					<LiveSearch
						placeholder="記事を検索"
						class="site-search"
						inputClass="site-search-input"
						resultsClass="site-search-results"
						resultClass="site-search-result"
						collections={["posts", "pages"]}
					/>
					{isLoggedIn && <a href="/_emdash/admin" class="site-admin">編集</a>}
				</div>
			</div>
		</header>

		<main id="main-content" tabindex="-1">
			{hasPageProfileSidebar ? (
				<div class="page-with-profile">
					<div class="page-with-profile__main"><slot /></div>
					<aside class="page-with-profile__aside" aria-label="プロフィール">
						<div class="page-with-profile__sticky"><ProfileCard /></div>
					</aside>
				</div>
			) : (
				<slot />
			)}
		</main>

		<footer class="site-footer">
			<div class="site-footer__inner">
				<div class="site-footer__lead">
					<a href="/" class="site-footer__brand">{siteTitle}</a>
					<p>{siteTagline}</p>
				</div>
				<nav class="site-footer__nav" aria-label="フッターナビゲーション">
					<div>
						<p class="micro-label">読む</p>
						<a href="/posts">すべての記事</a>
						<a href="/archives">月別アーカイブ</a>
						<a href="/rss.xml">RSS</a>
						<a href={photosUrl}>写真</a>
					</div>
					{pages.length > 0 && (
						<div>
							<p class="micro-label">ページ</p>
							{pages.map((page) => (
								<a href={`/pages/${page.data.slug || page.id}`}>{page.data.title}</a>
							))}
						</div>
					)}
				</nav>
				<div class="site-footer__bottom">
					<p><span>Yohaku</span> / kanouk.com</p>
					<ThemeSwitcher />
				</div>
			</div>
		</footer>

		<script>
			document.addEventListener("keydown", (event) => {
				if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
					event.preventDefault();
					const input = document.querySelector(".site-search-input") as HTMLInputElement | null;
					if (input && getComputedStyle(input).display !== "none") input.focus();
					else window.location.assign("/search");
				}
			});
		</script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
