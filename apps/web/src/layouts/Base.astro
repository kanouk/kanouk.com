---
import { getEmDashCollection, getSiteSettings } from "emdash";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import YohakuHead from "../components/YohakuHead.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null | false;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical: canonicalProp,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;

const canonical = canonicalProp === false
	? null
	: canonicalProp ?? new URL(Astro.url.pathname, "https://blog.kanouk.com").toString();

const { siteTitle, siteTagline, siteLogo } = resolveBlogSiteIdentity(await getSiteSettings());
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;
const FOOTER_EXCLUDED_PAGE_SLUGS = new Set(["sample_search", "sample-page-nocalog"]);
const { entries: pageCandidates } = await getEmDashCollection("pages", {
	status: "published",
	orderBy: { published_at: "desc" },
	limit: 8,
});
// Preserve imported sample routes, but do not promote theme/demo artifacts in
// the permanent site navigation.
const pages = pageCandidates
	.filter((page) => !FOOTER_EXCLUDED_PAGE_SLUGS.has(page.data.slug || page.id))
	.slice(0, 4);
const isPreviewHost = Astro.url.hostname.endsWith("workers.dev") || Astro.url.hostname === "localhost";
const photosUrl = isPreviewHost ? "/albums" : "https://photos.kanouk.com/albums";
const isLoggedIn = !!Astro.locals.user;
const currentPath = Astro.url.pathname;
const isSearchPage = currentPath === "/search";
const isArticleSurface = !isSearchPage && (
	currentPath === "/" ||
	currentPath.startsWith("/posts") ||
	currentPath.startsWith("/archives") ||
	currentPath.startsWith("/category/") ||
	currentPath.startsWith("/tag/") ||
	currentPath.startsWith("/pages/")
);

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<YohakuHead />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
	</head>
	<body class="site site--blog">
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link" href="#main-content">本文へ移動</a>

		<header class="site-header">
			<div class="site-header__inner">
				<a href="/" class="site-brand" aria-label={`${siteTitle} ホーム`}>
					{siteLogo && (
						<img src={siteLogo.url} alt="" class="site-brand__image" />
					)}
					<span class="site-brand__copy">
						<span class="site-brand__name">{siteTitle}</span>
						<span class="site-brand__tagline">{siteTagline}</span>
					</span>
				</a>

				<nav class="site-nav" aria-label="主要ナビゲーション">
					<a href="/posts" aria-current={isArticleSurface ? "page" : undefined}>記事</a>
					<a href={photosUrl}>写真</a>
					<a href="/search" aria-current={isSearchPage ? "page" : undefined}>検索</a>
				</nav>

				<div class="site-tools">
					<LiveSearch
						placeholder="記事を検索"
						class="site-search"
						inputClass="site-search-input"
						resultsClass="site-search-results"
						resultClass="site-search-result"
						collections={["posts", "pages"]}
					/>
					{isLoggedIn && <a href="/_emdash/admin" class="site-admin">編集</a>}
				</div>
			</div>
		</header>

		<main id="main-content" tabindex="-1">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="site-footer__inner">
				<div class="site-footer__lead">
					<a href="/" class="site-footer__brand">{siteTitle}</a>
					<p>{siteTagline}</p>
				</div>
				<nav class="site-footer__nav" aria-label="フッターナビゲーション">
					<div>
						<p class="micro-label">読む</p>
						<a href="/posts">すべての記事</a>
						<a href="/archives">月別アーカイブ</a>
						<a href="/rss.xml">RSS</a>
						<a href={photosUrl}>写真</a>
					</div>
					{pages.length > 0 && (
						<div>
							<p class="micro-label">ページ</p>
							{pages.map((page) => (
								<a href={`/pages/${page.data.slug || page.id}`}>{page.data.title}</a>
							))}
						</div>
					)}
				</nav>
				<div class="site-footer__bottom">
					<p><span>Yohaku</span> / kanouk.com</p>
					<ThemeSwitcher />
				</div>
			</div>
		</footer>

		<script>
			document.addEventListener("keydown", (event) => {
				if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
					event.preventDefault();
					(document.querySelector(".site-search-input") as HTMLInputElement | null)?.focus();
				}
			});
		</script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
