---
import { Font } from "astro:assets";

const GA4_MEASUREMENT_ID = "G-94EQ0WN7B9";
const analyticsEnabled = new Set(["blog.kanouk.com", "photos.kanouk.com"]).has(
	Astro.url.hostname,
);
---

<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#111211" media="(prefers-color-scheme: dark)" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/kano-profile.png" type="image/png" />
<link rel="apple-touch-icon" href="/kano-profile.png" />
<Font cssVariable="--font-body" />
<Font cssVariable="--font-mono" />
{analyticsEnabled && (
	<>
		<link rel="preconnect" href="https://www.googletagmanager.com" />
		<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_MEASUREMENT_ID}`}></script>
		<script is:inline define:vars={{ GA4_MEASUREMENT_ID }}>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag("js", new Date());
			gtag("config", GA4_MEASUREMENT_ID);
		</script>
	</>
)}
<script is:inline>
	(function () {
		var match = document.cookie.match(/(?:^|; )theme=([^;]+)/);
		var theme = match ? match[1] : "";
		if (theme === "dark" || theme === "light") document.documentElement.dataset.theme = theme;
	})();
</script>
