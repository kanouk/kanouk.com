---
import { MapPinned } from "lucide-astro";

interface Marker {
	latitude: number;
	longitude: number;
	title: string;
	href: string;
}

interface Props {
	markers: Marker[];
	count?: number;
	source?: string;
	/** Render only the panel; the page places a button with aria-controls={panelId}. */
	panelId?: string;
}

const { markers, count = markers.length, source, panelId } = Astro.props;
---

{
	count > 0 && (
		<section class:list={["album-map", panelId && "album-map--detached"]} data-album-map data-markers={JSON.stringify(markers)} data-source={source}>
			{!panelId && (
				<button type="button" class="album-map-toggle" aria-expanded="false">
					<MapPinned size={17} strokeWidth={1.75} aria-hidden="true" />
					<span>地図で見る</span>
					<small>
						{count.toLocaleString("ja-JP")}点<span class="album-map-count-copy">に撮影場所あり</span>
					</small>
				</button>
			)}
			<div class="album-map-panel" id={panelId} hidden>
				<div class="album-map-canvas" aria-label="アルバム内の撮影場所" />
			</div>
		</section>
	)
}

<script>
	import { showMarkers, type DrawnMap } from "../client/map";

	type Marker = {
		latitude: number;
		longitude: number;
		title: string;
		href: string;
	};

	document.querySelectorAll<HTMLElement>("[data-album-map]").forEach((shell) => {
		if (shell.dataset.initialized === "true") return;
		shell.dataset.initialized = "true";
		const panel = shell.querySelector<HTMLElement>(".album-map-panel");
		const toggle = shell.querySelector<HTMLButtonElement>(".album-map-toggle")
			?? (panel?.id ? document.querySelector<HTMLButtonElement>(`button[aria-controls="${panel.id}"]`) : null);
		const canvas = shell.querySelector<HTMLElement>(".album-map-canvas");
		if (!toggle || !panel || !canvas) return;

		let map: DrawnMap | undefined;
		let mapPromise: Promise<void> | undefined;
		let markers = JSON.parse(shell.dataset.markers || "[]") as Marker[];
		const initializeMap = async () => {
			if (map) return;
			if (mapPromise) return mapPromise;
			mapPromise = (async () => {
			const loaded = await (
                shell.dataset.source ? fetch(shell.dataset.source).then(async response => {
                    if (!response.ok) throw new Error("地図データを取得できませんでした");
                    return response.json() as Promise<{markers: Marker[]}>;
                }) : Promise.resolve({markers})
            );
            markers = loaded.markers;
            if (!markers.length) { canvas.textContent = "撮影場所の情報はありません。"; return; }
			map = await showMarkers(canvas, markers, "#17658c");
			})();
			return mapPromise;
		};

		toggle.addEventListener("click", async () => {
			const open = toggle.getAttribute("aria-expanded") !== "true";
			toggle.setAttribute("aria-expanded", String(open));
			panel.hidden = !open;
			toggle.querySelector("span")!.textContent = open ? "地図を閉じる" : "地図で見る";
			if (open) {
				try { await initializeMap(); }
                catch { mapPromise = undefined; canvas.textContent = "地図を取得できませんでした。閉じて開くと再試行できます。"; }
				window.setTimeout(() => map?.resize(), 0);
			}
		});
	});
</script>
