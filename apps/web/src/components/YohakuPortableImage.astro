---
import YohakuImage from "./YohakuImage.astro";

interface ImageNode {
	asset?: {
		_ref?: string;
		url?: string;
	};
	alt?: string;
	caption?: string;
	width?: number;
	height?: number;
	displayWidth?: number;
	alignment?: "left" | "center" | "right" | "wide" | "full";
	visualStyle?: "photo-frame" | "border" | "shadow";
}

interface Props {
	node: ImageNode;
}

const { node } = Astro.props;
const assetUrl = node?.asset?.url;
const bareStorageKey = assetUrl && /^[A-Za-z0-9._-]+$/.test(assetUrl) ? assetUrl : undefined;
const src = bareStorageKey
	? `/_emdash/api/media/file/${encodeURIComponent(bareStorageKey)}`
	: assetUrl ||
		(node?.asset?._ref
			? `/_emdash/api/media/file/${encodeURIComponent(node.asset._ref)}`
			: undefined);
const mediaId = bareStorageKey || node?.asset?._ref || "";
---

{
	src && (
		<figure
			class:list={[
				"yohaku-portable-image",
				node.alignment && `align-${node.alignment}`,
				node.visualStyle && `style-${node.visualStyle}`,
			]}
			style={node.displayWidth ? `--image-display-width:${node.displayWidth}px` : undefined}
		>
			<YohakuImage
				image={{
					id: mediaId,
					src,
					alt: node.alt || "",
					width: node.width,
					height: node.height,
				}}
				preview
			/>
			{node.caption && <figcaption>{node.caption}</figcaption>}
		</figure>
	)
}
