---
import "../styles/article-image-styles.css";
import { resolveArticleImageStyle } from "../utils/article-image-style.mjs";
import YohakuImage from "./YohakuImage.astro";

interface ImageNode {
	asset?: {
		_ref?: string;
		url?: string;
	};
	alt?: string;
	caption?: string;
	width?: number;
	height?: number;
	displayWidth?: number;
	alignment?: "left" | "center" | "right" | "wide" | "full";
	visualStyle?: string;
	// Legacy imports store a URL string; the EmDash editor (0.40+) stores { href, blank? }.
	link?: string | { href?: string; blank?: boolean };
	_yohakuPriority?: boolean;
}

interface Props {
	node: ImageNode;
}

const { node } = Astro.props;
const link = typeof node.link === "string"
	? (node.link ? { href: node.link, blank: false } : undefined)
	: typeof node.link?.href === "string" && node.link.href.trim()
		? { href: node.link.href.trim(), blank: node.link.blank === true }
		: undefined;
const visualStyle = resolveArticleImageStyle(node.visualStyle);
const assetUrl = node?.asset?.url;
const bareStorageKey = assetUrl && /^[A-Za-z0-9._-]+$/.test(assetUrl) ? assetUrl : undefined;
const mediaFileStorageKey = assetUrl?.match(/^\/_emdash\/api\/media\/file\/([^/?#]+)$/)?.[1];
const storageKey = bareStorageKey || (mediaFileStorageKey
	? decodeURIComponent(mediaFileStorageKey)
	: undefined);
const src = bareStorageKey
	? `/_emdash/api/media/file/${encodeURIComponent(bareStorageKey)}`
	: assetUrl ||
		(node?.asset?._ref
			? `/_emdash/api/media/file/${encodeURIComponent(node.asset._ref)}`
			: undefined);
const mediaId = node?.asset?._ref || storageKey || "";
const imageValue = {
	id: mediaId,
	src,
	alt: node.alt || "",
	width: node.width,
	height: node.height,
	meta: storageKey ? { storageKey } : undefined,
};
---

{
	src && (
		<figure
			class:list={[
				"yohaku-portable-image",
				node.alignment && `align-${node.alignment}`,
				`style-${visualStyle}`,
			]}
			style={node.displayWidth ? `--image-display-width:${node.displayWidth}px` : undefined}
		>
			{link ? (
				<a href={link.href} class="yohaku-portable-image__link" data-image-lightbox target={link.blank ? "_blank" : undefined} rel={link.blank ? "noopener noreferrer" : undefined}>
					<YohakuImage image={imageValue} preview priority={node._yohakuPriority} sizes="(max-width: 900px) calc(100vw - 2rem), 48rem" />
				</a>
			) : (
				<button type="button" class="yohaku-portable-image__link" data-image-lightbox aria-label={node.alt ? `${node.alt}を拡大` : "写真を拡大"}>
					<YohakuImage image={imageValue} preview priority={node._yohakuPriority} sizes="(max-width: 900px) calc(100vw - 2rem), 48rem" />
				</button>
			)}
			{node.caption && <figcaption>{node.caption}</figcaption>}
		</figure>
	)
}

<script>
	import "../client/image-lightbox";
</script>
