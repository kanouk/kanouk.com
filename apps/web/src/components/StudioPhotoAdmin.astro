---
import {
	readStudioSession,
	STUDIO_SESSION_COOKIE,
} from "../studio/session";
import { studioEnvironment } from "../studio/environment";

interface Props {
	content?: { collection: string; id: string; slug?: string | null };
}

const { content } = Astro.props;
const session = await readStudioSession(
	studioEnvironment(),
	Astro.cookies.get(STUDIO_SESSION_COOKIE)?.value,
);
const blogOrigin = Astro.url.hostname === "photos.kanouk.com"
	? "https://blog.kanouk.com"
	: Astro.url.hostname === "photos-staging.kanouk.com"
		? "https://blog-staging.kanouk.com"
		: Astro.url.origin;
const studioUrl = content?.collection === "albums"
	? `${blogOrigin}/_emdash/admin/plugins/yohaku-photo-studio/albums?album=${encodeURIComponent(content.id)}`
	: content?.collection === "photos"
		? `${blogOrigin}/_emdash/admin/plugins/yohaku-photo-studio/photos?photo=${encodeURIComponent(content.id)}`
		: `${blogOrigin}/_emdash/admin/plugins/yohaku-photo-studio/albums`;
---

{session && (
	<aside
		class="studio-public-admin"
		data-studio-public-admin
		data-collection={content?.collection ?? ""}
		data-content-id={content?.id ?? ""}
	>
		<div class="studio-public-admin__bar">
			<strong>Studio 管理</strong>
			<button type="button" data-studio-toggle aria-pressed="false">管理モードをON</button>
			<button type="button" data-studio-reload>再読込</button>
			<a href={studioUrl}>Studioで詳しく編集</a>
			<button type="button" data-studio-logout>終了</button>
			<span role="status" aria-live="polite" data-studio-status>閲覧中</span>
		</div>
		<div class="studio-public-admin__panel" data-studio-panel hidden></div>

		<style is:inline>
			.studio-public-admin{position:relative;z-index:1000;background:#111;color:#fff;font:14px/1.5 system-ui,sans-serif}.studio-public-admin__bar{display:flex;align-items:center;gap:.65rem;min-height:44px;padding:.45rem max(1rem,calc((100vw - 1200px)/2));flex-wrap:wrap}.studio-public-admin button,.studio-public-admin a{border:1px solid #ffffff55;border-radius:.45rem;background:#ffffff12;color:#fff;padding:.35rem .65rem;text-decoration:none;cursor:pointer}.studio-public-admin button:hover,.studio-public-admin a:hover{background:#ffffff25}.studio-public-admin [data-studio-status]{margin-inline-start:auto;color:#d7d7d7}.studio-public-admin__panel{background:light-dark(#fff,#181818);color:light-dark(#161616,#f6f6f6);border-bottom:1px solid #7775;padding:1rem max(1rem,calc((100vw - 1100px)/2));box-shadow:0 12px 28px #0003}.studio-public-admin__panel form{display:grid;gap:.75rem;max-width:760px}.studio-public-admin__panel label{display:grid;gap:.3rem;font-weight:650}.studio-public-admin__panel input,.studio-public-admin__panel textarea,.studio-public-admin__panel select{box-sizing:border-box;width:100%;border:1px solid #8888;border-radius:.45rem;background:transparent;color:inherit;padding:.55rem}.studio-public-admin__actions{display:flex;gap:.5rem;flex-wrap:wrap}.studio-public-admin__actions button{background:#1464d2;border-color:#1464d2}.studio-public-admin__photos{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:.75rem;margin-top:1rem}.studio-public-admin__photo{display:grid;gap:.45rem;border:1px solid #8885;border-radius:.6rem;padding:.55rem}.studio-public-admin__photo img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:.4rem}.studio-public-admin__photo textarea{min-height:4.5rem}.studio-public-admin__photo-actions{display:flex;gap:.35rem;flex-wrap:wrap}.studio-public-admin__photo-actions button{color:inherit;border-color:#8888;background:transparent;padding:.3rem .5rem}.studio-public-admin__empty{border:1px dashed #9998;border-radius:.5rem;padding:1rem}.studio-public-admin [draggable=true]{cursor:grab}.studio-public-admin [data-dragging=true]{opacity:.45}@media(max-width:600px){.studio-public-admin__bar{align-items:stretch}.studio-public-admin__bar>*{flex:1 1 auto}.studio-public-admin [data-studio-status]{margin-inline-start:0;flex-basis:100%}.studio-public-admin__photos{grid-template-columns:repeat(2,minmax(0,1fr))}}
		</style>

		<script is:inline>
			(() => {
				const root = document.querySelector('[data-studio-public-admin]');
				if (!root) return;
				const toggle = root.querySelector('[data-studio-toggle]');
				const panel = root.querySelector('[data-studio-panel]');
				const status = root.querySelector('[data-studio-status]');
				const collection = root.dataset.collection;
				const contentId = root.dataset.contentId;
				let loaded = false;
				let photos = [];
				let albums = [];

				const setStatus = (message, error = false) => {
					status.textContent = message;
					status.style.color = error ? '#ffb4ab' : '#d7d7d7';
				};
				const request = async (path, options) => {
					const response = await fetch(path, {
						credentials: 'same-origin',
						headers: { 'Content-Type': 'application/json', ...(options?.headers || {}) },
						...options,
					});
					const payload = await response.json().catch(() => ({}));
					if (!response.ok || payload.success === false) {
						const error = new Error(payload.error?.message || '操作に失敗しました。');
						error.code = payload.error?.code;
						throw error;
					}
					return payload;
				};
				const getItem = async (kind, id) => {
					const payload = await request(`/studio/api/public-content?collection=${encodeURIComponent(kind)}&id=${encodeURIComponent(id)}`);
					return payload.data;
				};
				const getAll = async (path) => {
					const items = [];
					let cursor = '';
					do {
						const target = new URL(path, location.origin);
						if (cursor) target.searchParams.set('cursor', cursor);
						const payload = await request(`${target.pathname}${target.search}`);
						items.push(...(payload.data?.items || []));
						cursor = payload.data?.nextCursor || '';
					} while (cursor);
					return items;
				};
				const saveItem = async (kind, id, data) => {
					const current = await getItem(kind, id);
					return request('/studio/api/public-content', {
						method: 'PUT',
						body: JSON.stringify({ collection: kind, id, _rev: current._rev, data }),
					});
				};
				const publishItem = (kind, id) => request('/studio/api/public-content', {
					method: 'POST',
					body: JSON.stringify({ action: 'publish', collection: kind, id }),
				});
				const value = (data, key) => typeof data?.[key] === 'string' ? data[key] : '';
				const escape = (input) => String(input ?? '').replace(/[&<>"']/g, (char) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[char]));
				const imageUrl = (image) => {
					const source = image?.src || image?.url || image?.previewUrl || '';
					const matchedKey = source.match(/^\/_emdash\/api\/media\/file\/([^/?#]+)$/)?.[1];
					const storageKey = image?.meta?.storageKey || (matchedKey ? decodeURIComponent(matchedKey) : '');
					return storageKey
						? `/_yohaku/media/preview-v2/320/webp/${encodeURIComponent(storageKey)}`
						: source;
				};

				async function renderPhotoEditor() {
					const current = await getItem('photos', contentId);
					const item = current.item;
					panel.innerHTML = `<form data-studio-form>
						<label>タイトル<input name="title" value="${escape(value(item.data,'title'))}"></label>
						<label>キャプション<textarea name="caption" placeholder="キャプションを追加">${escape(value(item.data,'caption'))}</textarea></label>
						<label>代替テキスト<input name="alt" value="${escape(value(item.data,'alt'))}"></label>
						<label>撮影日<input name="captured_at" type="datetime-local" value="${escape(value(item.data,'captured_at').slice(0,16))}"></label>
						<div class="studio-public-admin__actions"><button type="submit">下書き保存</button><button type="button" data-studio-publish>公開</button></div>
					</form>`;
					const form = panel.querySelector('[data-studio-form]');
					form.addEventListener('submit', async (event) => {
						event.preventDefault(); setStatus('保存中…');
						const data = Object.fromEntries(new FormData(form));
						try { await saveItem('photos', contentId, data); setStatus('下書き保存済み'); }
						catch (error) { setStatus(error.code === 'CONFLICT' ? '競合あり。再読込してください。' : '保存失敗', true); }
					});
					panel.querySelector('[data-studio-publish]').addEventListener('click', async () => {
						setStatus('公開中…');
						try { await publishItem('photos', contentId); setStatus('公開済み。ページを再読込します。'); location.reload(); }
						catch { setStatus('公開失敗', true); }
					});
				}

				function photoCard(item, index) {
					const src = imageUrl(item.data.image);
					return `<article class="studio-public-admin__photo" draggable="true" data-photo-id="${escape(item.id)}" data-index="${index}">
						${src ? `<img src="${escape(src)}" alt="">` : '<div class="studio-public-admin__empty">画像なし</div>'}
						<textarea data-caption placeholder="キャプションを追加">${escape(value(item.data,'caption'))}</textarea>
						<input data-alt aria-label="代替テキスト" placeholder="代替テキスト" value="${escape(value(item.data,'alt'))}">
						<input data-captured aria-label="撮影日" type="datetime-local" value="${escape(value(item.data,'captured_at').slice(0,16))}">
						<label>移動先<select data-album>${albums.map((album) => `<option value="${escape(album.id)}" ${value(item.data,'album') === album.id ? 'selected' : ''}>${escape(value(album.data,'title') || album.slug || album.id)}</option>`).join('')}</select></label>
						<div class="studio-public-admin__photo-actions"><button type="button" data-save>保存</button><button type="button" data-cover>カバー</button><button type="button" data-up aria-label="前へ移動">↑</button><button type="button" data-down aria-label="後ろへ移動">↓</button></div>
					</article>`;
				}

				async function saveOrder() {
					setStatus('並び順を保存中…');
					const failures = [];
					for (let index = 0; index < photos.length; index += 1) {
						const position = (index + 1) * 1024;
						if (Number(photos[index].data.position) === position) continue;
						try { await saveItem('photos', photos[index].id, { position }); photos[index].data.position = position; }
						catch (error) { failures.push(photos[index].id); }
					}
					setStatus(failures.length ? `${failures.length}件の並べ替えに失敗` : '並び順を下書き保存済み', failures.length > 0);
				}

				function bindPhotoCards(album) {
					const grid = panel.querySelector('[data-studio-photo-grid]');
					const rerender = () => { grid.innerHTML = photos.map(photoCard).join(''); bindPhotoCards(album); };
					grid.querySelectorAll('[data-photo-id]').forEach((card) => {
						const id = card.dataset.photoId;
						card.querySelector('[data-save]').addEventListener('click', async () => {
							setStatus('保存中…');
							try {
								const targetAlbum = card.querySelector('[data-album]').value;
								await saveItem('photos', id, { caption: card.querySelector('[data-caption]').value, alt: card.querySelector('[data-alt]').value, captured_at: card.querySelector('[data-captured]').value, album: targetAlbum });
								if (targetAlbum !== contentId) { photos = photos.filter((candidate) => candidate.id !== id); rerender(); setStatus('別のアルバムへ移動しました（下書き）'); }
								else setStatus('下書き保存済み');
							}
							catch (error) { setStatus(error.code === 'CONFLICT' ? '競合あり。再読込してください。' : '保存失敗', true); }
						});
						card.querySelector('[data-cover]').addEventListener('click', async () => {
							const photo = photos.find((candidate) => candidate.id === id);
							setStatus('カバーを保存中…');
							try { await saveItem('albums', contentId, { cover_image: photo.data.image }); setStatus('カバーを下書き保存済み'); }
							catch { setStatus('カバー保存失敗', true); }
						});
						const move = async (delta) => {
							const index = photos.findIndex((candidate) => candidate.id === id);
							const target = index + delta;
							if (target < 0 || target >= photos.length) return;
							[photos[index], photos[target]] = [photos[target], photos[index]];
							rerender(); await saveOrder();
						};
						card.querySelector('[data-up]').addEventListener('click', () => move(-1));
						card.querySelector('[data-down]').addEventListener('click', () => move(1));
						card.addEventListener('dragstart', (event) => { card.dataset.dragging = 'true'; event.dataTransfer?.setData('text/plain', id); });
						card.addEventListener('dragend', () => { delete card.dataset.dragging; });
						card.addEventListener('dragover', (event) => event.preventDefault());
						card.addEventListener('drop', async (event) => {
							event.preventDefault(); const sourceId = event.dataTransfer?.getData('text/plain');
							const from = photos.findIndex((candidate) => candidate.id === sourceId); const to = photos.findIndex((candidate) => candidate.id === id);
							if (from < 0 || to < 0 || from === to) return;
							const [moved] = photos.splice(from, 1); photos.splice(to, 0, moved); rerender(); await saveOrder();
						});
					});
				}

				async function renderAlbumEditor() {
					const [current, photoItems, albumItems] = await Promise.all([
						getItem('albums', contentId),
						getAll(`/studio/api/public-content?collection=photos&albumId=${encodeURIComponent(contentId)}`),
						getAll('/studio/api/public-content?collection=albums'),
					]);
					const album = current.item;
					photos = photoItems;
					albums = albumItems;
					panel.innerHTML = `<form data-studio-form>
						<label>アルバム名<input name="title" value="${escape(value(album.data,'title'))}"></label>
						<label>説明<textarea name="description">${escape(value(album.data,'description'))}</textarea></label>
						<div class="studio-public-admin__actions"><button type="submit">基本情報を下書き保存</button><button type="button" data-studio-publish>公開</button><label>写真を追加<input type="file" accept="image/*" multiple data-studio-upload></label></div>
					</form><h2>写真 ${photos.length}点</h2><div class="studio-public-admin__photos" data-studio-photo-grid>${photos.map(photoCard).join('')}</div>`;
					const form = panel.querySelector('[data-studio-form]');
					form.addEventListener('submit', async (event) => {
						event.preventDefault(); setStatus('保存中…');
						try { await saveItem('albums', contentId, Object.fromEntries(new FormData(form))); setStatus('下書き保存済み'); }
						catch (error) { setStatus(error.code === 'CONFLICT' ? '競合あり。再読込してください。' : '保存失敗', true); }
					});
					panel.querySelector('[data-studio-publish]').addEventListener('click', async () => {
						setStatus('公開中…');
						try { await publishItem('albums', contentId); setStatus('公開済み。ページを再読込します。'); location.reload(); }
						catch { setStatus('公開失敗', true); }
					});
					panel.querySelector('[data-studio-upload]').addEventListener('change', async (event) => {
						const files = [...(event.target.files || [])].slice(0, 20);
						if (!files.length) return;
						setStatus('写真を追加中…');
						let position = Math.max(0, ...photos.map((photo) => Number(photo.data.position) || 0));
						const failures = [];
						for (const file of files) {
							try {
								const form = new FormData(); form.append('file', file);
								const uploadResponse = await fetch('/studio/api/public-media', { method: 'POST', credentials: 'same-origin', headers: { 'X-EmDash-Request': '1' }, body: form });
								const upload = await uploadResponse.json();
								if (!uploadResponse.ok || !upload.success || !upload.data?.item) throw new Error(upload.error?.message || 'アップロード失敗');
								const media = upload.data.item; position += 1024;
								const title = file.name.replace(/\.[^.]+$/, '').replace(/[_-]+/g, ' ').trim() || '写真';
								const created = await request('/studio/api/public-content', { method: 'POST', body: JSON.stringify({ action: 'create-photo', collection: 'photos', data: { title, image: { id: media.id, src: media.url, filename: media.filename, mimeType: media.mimeType, width: media.width, height: media.height, meta: media.storageKey ? { storageKey: media.storageKey } : undefined }, alt: title, caption: '', captured_at: '', album: contentId, position } }) });
								photos.push(created.data.item);
							} catch (error) { failures.push(file.name); }
						}
						event.target.value = ''; panel.querySelector('[data-studio-photo-grid]').innerHTML = photos.map(photoCard).join(''); bindPhotoCards(album);
						setStatus(failures.length ? `${files.length - failures.length}点追加・${failures.length}点失敗` : `${files.length}点を下書きへ追加`, failures.length > 0);
					});
					bindPhotoCards(album);
				}

				toggle.addEventListener('click', async () => {
					const active = toggle.getAttribute('aria-pressed') !== 'true';
					toggle.setAttribute('aria-pressed', String(active));
					toggle.textContent = active ? '管理モードをOFF' : '管理モードをON';
					panel.hidden = !active;
					if (!active || loaded || !contentId) { setStatus(active ? '編集可能' : '閲覧中'); return; }
					setStatus('編集データを読込中…');
					try { collection === 'albums' ? await renderAlbumEditor() : await renderPhotoEditor(); loaded = true; setStatus('編集可能'); }
					catch { panel.innerHTML = '<p class="studio-public-admin__empty">編集データを読み込めませんでした。</p>'; setStatus('読込失敗', true); }
				});
				root.querySelector('[data-studio-logout]').addEventListener('click', async () => {
					await fetch('/studio/api/session', { method: 'DELETE', credentials: 'same-origin' });
					location.reload();
				});
				root.querySelector('[data-studio-reload]').addEventListener('click', () => location.reload());
			})();
		</script>
	</aside>
)}
