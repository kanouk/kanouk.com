---
import PostArchiveNav from "./PostArchiveNav.astro";
import ProfileCard from "./ProfileCard.astro";
import SidebarTaxonomies from "./SidebarTaxonomies.astro";

interface Props {
	latestDate?: Date | null;
}

const { latestDate } = Astro.props;
---

<aside class="home-sidebar" aria-label="ブログ案内">
	<ProfileCard />

	<div class="sidebar-widgets home-sidebar__widgets">
		<PostArchiveNav date={latestDate} />
		<SidebarTaxonomies />
	</div>
</aside>
