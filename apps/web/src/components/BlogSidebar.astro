---
import { getTaxonomyTerms } from "emdash";
import { Tags } from "lucide-astro";
import PostArchiveNav from "./PostArchiveNav.astro";
import ProfileCard from "./ProfileCard.astro";

interface Props {
	latestDate?: Date | null;
}

type SidebarTerm = Awaited<ReturnType<typeof getTaxonomyTerms>>[number];

const { latestDate } = Astro.props;

function flattenTerms(terms: SidebarTerm[]): SidebarTerm[] {
	return terms.flatMap((term) => [term, ...flattenTerms(term.children)]);
}

const [categoryTerms, tagTerms] = await Promise.all([
	getTaxonomyTerms("category", { includeCounts: true }),
	getTaxonomyTerms("tag", { includeCounts: true }),
]);
const categories = flattenTerms(categoryTerms).filter((term) => (term.count ?? 0) > 0);
const tags = flattenTerms(tagTerms)
	.filter((term) => (term.count ?? 0) > 0)
	.slice(0, 20);
---

<aside class="home-sidebar" aria-label="ブログ案内">
	<ProfileCard />

	<div class="sidebar-widgets home-sidebar__widgets">
		<PostArchiveNav date={latestDate} />
		{categories.length > 0 && (
			<section class="widget">
				<h2 class="widget__title">カテゴリー</h2>
				<div class="widget__content">
					<ul class="widget-categories">
						{categories.map((category) => (
							<li>
								<a href={`/category/${category.slug}`} class="widget-categories__link">{category.label}</a>
								<span class="widget-categories__count">{category.count}</span>
							</li>
						))}
					</ul>
				</div>
			</section>
		)}
		{tags.length > 0 && (
			<section class="widget">
				<h2 class="widget__title"><Tags size={14} strokeWidth={1.7} aria-hidden="true" /> トピック</h2>
				<div class="widget__content">
					<ul class="widget-tags__cloud">
						{tags.map((tag) => (
							<li><a href={`/tag/${tag.slug}`} class="widget-tags__link">{tag.label}</a></li>
						))}
					</ul>
				</div>
			</section>
		)}
	</div>
</aside>
