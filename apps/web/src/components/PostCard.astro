---
import type { MediaValue } from "emdash";
import YohakuImage from "./YohakuImage.astro";

interface Props {
	title: string;
	excerpt?: string;
	featuredImage?: MediaValue | string;
	href: string;
	date?: Date;
	readingTime?: number;
	categories?: Array<{ slug: string; label: string }>;
	tags?: Array<{ slug: string; label: string }>;
	variant?: "card" | "list";
	priority?: boolean;
}

const {
	title,
	excerpt,
	featuredImage,
	href,
	date,
	readingTime,
	categories,
	tags,
	variant = "card",
	priority = false,
} = Astro.props;

const imageSizes =
	variant === "list"
		? "(max-width: 719px) calc(100vw - 2rem), 15rem"
		: "(max-width: 719px) calc(100vw - 2rem), (max-width: 1100px) 50vw, 22rem";

const formattedDate = date
	? date.toLocaleDateString("ja-JP", {
			year: "numeric",
			month: "2-digit",
			day: "2-digit",
		})
	: null;
---

<article class:list={["post-card", { "post-card--list": variant === "list" }]}>
	<a href={href} class="card-link" data-astro-prefetch="hover">
		<div class="card-media">
			{
				featuredImage ? (
					<div class="card-image">
						<YohakuImage image={featuredImage} crop priority={priority} sizes={imageSizes} />
					</div>
				) : (
					<div class="card-image">
						<img
							src="/kanolog-no-image.png"
							alt=""
							width="768"
							height="403"
							loading={priority ? "eager" : "lazy"}
							fetchpriority={priority ? "high" : undefined}
							decoding="async"
							class="card-no-image"
						/>
					</div>
				)
			}
			{(categories?.length ?? 0) > 0 && (
				<div class="card-categories" aria-label="カテゴリー">
					{categories?.slice(0, 1).map((category) => (
						<span class="card-category">{category.label}</span>
					))}
				</div>
			)}
		</div>
		<div class="card-body">
			<h2 class="card-title">{title}</h2>
			{
				(tags?.length ?? 0) > 0 && (
					<div class="card-taxonomies" aria-label="タグ">
						{tags?.slice(0, 2).map((tag) => (
							<span class="card-tag">{tag.label}</span>
						))}
					</div>
				)
			}
			{excerpt && <p class="card-excerpt">{excerpt}</p>}
			<div class="card-meta">
				{formattedDate && <time>{formattedDate}</time>}
				{formattedDate && readingTime && <span class="meta-dot" />}
				{readingTime && <span>{readingTime}分</span>}
			</div>
		</div>
	</a>
</article>
