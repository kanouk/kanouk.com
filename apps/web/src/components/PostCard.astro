---
import type { MediaValue } from "emdash";
import YohakuImage from "./YohakuImage.astro";
import { resolveImageSource } from "../utils/image-source";
import { siteDateLabel } from "../utils/photo-date.mjs";
import { visibleTags } from "../utils/hidden-tags.mjs";

interface Props {
	title: string;
	excerpt?: string;
	featuredImage?: MediaValue | string;
	href: string;
	date?: Date;
	readingTime?: number;
	tags?: Array<{ slug: string; label: string }>;
	variant?: "card" | "list";
	priority?: boolean;
}

const {
	title,
	excerpt,
	featuredImage,
	href,
	date,
	readingTime,
	tags: allTags,
	variant = "card",
	priority = false,
} = Astro.props;

const imageSizes =
	variant === "list"
		? "(max-width: 719px) calc(100vw - 2rem), 15rem"
		: "(max-width: 719px) calc(100vw - 2rem), (max-width: 1100px) 50vw, 22rem";

const tags = visibleTags(allTags);
const formattedDate = date ? siteDateLabel(date) : null;
---

<article class:list={["post-card", { "post-card--list": variant === "list" }]}>
	<a href={href} class="card-link" data-astro-prefetch="hover">
		<div class="card-media">
			{
				resolveImageSource(featuredImage) ? (
					<div class="card-image">
						<YohakuImage image={featuredImage} alt="" crop priority={priority} sizes={imageSizes} />
					</div>
				) : (
					<div class="card-image card-image--empty" aria-hidden="true">
						{formattedDate && <span class="card-image__year">{formattedDate.slice(0, 4)}</span>}
					</div>
				)
			}
		</div>
		<div class="card-body">
			<div class="card-meta">
				{formattedDate && <time datetime={date?.toISOString()}>{formattedDate}</time>}
				{readingTime && <span>{readingTime}分で読む</span>}
			</div>
			<h2 class="card-title">{title}</h2>
			{excerpt && <p class="card-excerpt">{excerpt}</p>}
			{
				(tags?.length ?? 0) > 0 && (
					<div class="card-taxonomies" aria-label="タグ">
						{tags?.slice(0, 2).map((tag) => (
							<span class="card-tag">#{tag.label}</span>
						))}
					</div>
				)
			}
		</div>
	</a>
</article>
