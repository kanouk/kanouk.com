---
import { getEmDashCollection, getEmDashEntry } from "emdash";
import { Image } from "emdash/ui";
import Photos from "../../layouts/Photos.astro";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

const { entry: album, cacheHint: albumCache } = await getEmDashEntry("albums", slug);
if (!album) return Astro.redirect("/404");
if (Astro.cache?.enabled) Astro.cache.set(albumCache);

const { entries: photos, cacheHint: photoCache } = await getEmDashCollection("photos", {
	status: "published",
	where: { album: album.data.id },
	orderBy: { position: "asc" },
	limit: 100,
});
if (Astro.cache?.enabled) Astro.cache.set(photoCache);
---

<Photos
	title={album.data.title}
	description={album.data.description}
	image={album.data.cover_image?.src}
	content={{ collection: "albums", id: album.data.id, slug: album.id }}
>
	<article class="album-page">
		<a class="back" href="/albums">← Albums</a>
		<header>
			<h1 {...album.edit.title}>{album.data.title}</h1>
			{album.data.description && <p {...album.edit.description}>{album.data.description}</p>}
			<p class="count">{photos.length} photo{photos.length === 1 ? "" : "s"}</p>
		</header>

		<div class="photo-grid">
			{photos.map((photo) => (
				<a class="photo-card" href={`/photos/${photo.id}`} aria-label={photo.data.alt || photo.data.title}>
					<Image image={photo.data.image} />
					{photo.data.title && <span>{photo.data.title}</span>}
				</a>
			))}
		</div>
	</article>
</Photos>

<style>
	.album-page { max-width: 80rem; margin: 0 auto; padding: 3rem clamp(1rem, 4vw, 3rem); }
	.back { color: var(--color-text-secondary); text-decoration: none; }
	header { max-width: 48rem; margin: 3rem 0; }
	h1 { margin: 0 0 1rem; font-size: clamp(2.5rem, 6vw, 5rem); letter-spacing: -0.045em; }
	header > p { color: var(--color-text-secondary); font-size: 1.05rem; line-height: 1.75; }
	.count { font: 500 0.75rem/1 var(--font-mono), monospace; letter-spacing: 0.08em; text-transform: uppercase; }
	.photo-grid { columns: 3 18rem; column-gap: 1rem; }
	.photo-card { display: block; break-inside: avoid; margin-bottom: 1rem; color: inherit; text-decoration: none; }
	.photo-card :global(img) { display: block; width: 100%; height: auto; }
	.photo-card span { display: block; padding: 0.55rem 0; color: var(--color-text-secondary); font-size: 0.85rem; }
</style>
