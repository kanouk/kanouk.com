---
import { getEmDashCollection, getEmDashEntry } from "emdash";
import { ArrowLeft, Images } from "lucide-astro";
import AlbumMap from "../../components/AlbumMap.astro";
import YohakuImage from "../../components/YohakuImage.astro";
import Photos from "../../layouts/Photos.astro";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

const { entry: album, cacheHint: albumCache } = await getEmDashEntry("albums", slug);
if (!album) return Astro.redirect("/404");
if (Astro.cache?.enabled) Astro.cache.set(albumCache);

const { entries: photos, cacheHint: photoCache } = await getEmDashCollection("photos", {
	status: "published",
	where: { album: album.data.id },
	orderBy: { position: "asc" },
});
if (Astro.cache?.enabled) Astro.cache.set(photoCache);

const locationPhotos = photos.flatMap((photo) => {
	const latitude = photo.data.latitude;
	const longitude = photo.data.longitude;
	if (
		typeof latitude !== "number" ||
		!Number.isFinite(latitude) ||
		latitude < -90 ||
		latitude > 90 ||
		typeof longitude !== "number" ||
		!Number.isFinite(longitude) ||
		longitude < -180 ||
		longitude > 180
	) return [];
	return [{
		latitude,
		longitude,
		title: photo.data.title || photo.data.alt || "写真を見る",
		href: `/photos/${photo.id}`,
	}];
});
---

<Photos
	title={album.data.title}
	description={album.data.description}
	image={album.data.cover_image?.src}
	content={{ collection: "albums", id: album.data.id, slug: album.id }}
>
	<article class="album-page">
		<a class="back" href="/albums">
			<ArrowLeft size={15} strokeWidth={1.75} aria-hidden="true" />
			<span>すべてのアルバム</span>
		</a>
		<header>
			<h1 {...album.edit.title}>{album.data.title}</h1>
			{album.data.description && <p {...album.edit.description}>{album.data.description}</p>}
			<p class="count">
				<Images size={15} strokeWidth={1.75} aria-hidden="true" />
				<span>{photos.length}点</span>
			</p>
		</header>
		<AlbumMap markers={locationPhotos} />

		<div class="photo-grid">
			{photos.map((photo) => (
				<a class="photo-card" href={`/photos/${photo.id}`} aria-label={photo.data.alt || photo.data.title}>
					<YohakuImage image={photo.data.image} />
					{photo.data.kind === "video" && <span class="video-badge">動画</span>}
					{photo.data.title && <span>{photo.data.title}</span>}
				</a>
			))}
		</div>
	</article>
</Photos>
