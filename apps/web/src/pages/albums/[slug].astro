---
import { getEmDashEntry } from "emdash";
import { ArrowLeft, ArrowUpRight, BookOpen, CirclePlay, Grid2x2, Grid3x3, Images } from "lucide-astro";
import { env } from "virtual:emdash/env";
import AlbumMap from "../../components/AlbumMap.astro";
import YohakuImage from "../../components/YohakuImage.astro";
import Photos from "../../layouts/Photos.astro";
import { resolvePublicMediaUrl } from "../../utils/media-url";
import { looksLikeSourceFilename, publicPhotoTitle } from "../../utils/photo-display.mjs";
import { PHOTO_GRID_SIZE } from "../../utils/photo-grid-size.mjs";
import { getAlbumPage } from "../../utils/album-page";
import { photoPath } from "../../utils/photo-url.mjs";
import { albumPhotoAnchor } from "../../utils/photo-return.mjs";
import { relatedAlbumArticles } from "../../utils/album-articles.mjs";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

const { entry: album, cacheHint: albumCache } = await getEmDashEntry("albums", slug);
if (!album) return Astro.redirect("/404");
if (Astro.cache?.enabled) Astro.cache.set(albumCache);

const requestedPage = Number(Astro.url.searchParams.get("page") ?? 1);
const photoTarget = Astro.url.searchParams.get("photo") ?? "";
const result = await getAlbumPage(album.data.id, Number.isSafeInteger(requestedPage) ? requestedPage : 1, photoTarget);
const chronologicalPhotos = result.photos;
if (Astro.cache?.enabled) Astro.cache.set({ tags: ["albums", "photos"] });
const pageHref = (page: number) => `/albums/${encodeURIComponent(album.id)}${page > 1 ? `?page=${page}` : ""}`;
const coverImageUrl = resolvePublicMediaUrl(album.data.cover_image);
if (!env?.DB) throw new Error("Cloudflare D1 binding DB is unavailable");
const relatedPosts = await relatedAlbumArticles(env.DB, album.data.id);
if (Astro.cache?.enabled) Astro.cache.set({ tags: ["posts"] });
const isLocal = ["localhost", "127.0.0.1"].includes(Astro.url.hostname);
const blogOrigin = isLocal || Astro.url.hostname.endsWith("workers.dev") ? "" : "https://blog.kanouk.com";
---

<Photos
	canonicalPath={pageHref(result.page)}
	title={album.data.title}
	description={album.data.description}
	image={coverImageUrl}
	pageType="collection"
	content={{ collection: "albums", id: album.data.id, slug: album.id }}
>
	<article class="album-page">
		<a class="back" href="/albums" data-astro-prefetch="hover">
			<ArrowLeft size={15} strokeWidth={1.75} aria-hidden="true" />
			<span>すべてのアルバム</span>
		</a>
		<header>
			<h1 {...album.edit.title}>{album.data.title}</h1>
			{album.data.description && <p {...album.edit.description}>{album.data.description}</p>}
			<p class="count">
				<Images size={15} strokeWidth={1.75} aria-hidden="true" />
				<span>{result.total}点</span>
			</p>
		</header>
		{relatedPosts.length > 0 && (
			<nav class="album-related-posts" aria-label="関連するブログ記事">
				<ul class="album-related-posts__list">
					{relatedPosts.map((post) => (
						<li class="album-related-posts__item"><a class="album-related-posts__link" href={`${blogOrigin}/posts/${encodeURIComponent(post.id)}`}>
							<BookOpen size={16} strokeWidth={1.65} aria-hidden="true" />
							<span>ブログ記事を読む<span class="album-related-posts__post-title">{post.title}</span></span>
							<ArrowUpRight size={15} strokeWidth={1.65} aria-hidden="true" />
						</a></li>
					))}
				</ul>
			</nav>
		)}
		<AlbumMap markers={[]} count={result.mapCount} source={`/albums/${encodeURIComponent(album.id)}/map.json`} />

		<nav class="album-pagination" aria-label="アルバムのページ">
            {result.page > 1 && <a href={pageHref(result.page - 1)} rel="prev">前の50件</a>}
            <span>{result.page} / {result.pageCount}ページ</span>
            {result.page < result.pageCount && <a href={pageHref(result.page + 1)} rel="next">次の50件</a>}
        </nav>
        <div class="photo-grid" data-photo-grid data-album-id={album.data.id}>
			{chronologicalPhotos.map((photo, index) => {
				const displayTitle = publicPhotoTitle({
					title: photo.data.title,
					sourceSystem: photo.data.source_system,
					sourceMetadata: photo.data.source_metadata,
				});
				const storedAlt = photo.data.alt?.trim() || photo.data.image?.alt?.trim();
				const publicAlt = storedAlt && !looksLikeSourceFilename(storedAlt)
					? storedAlt
					: displayTitle || photo.data.caption?.trim() || `${album.data.title}の写真 ${index + 1}`;
				return (
				<a class="photo-card" id={albumPhotoAnchor(photo.data.id)} data-photo-id={photo.data.id} href={photoPath(photo.id)} aria-label={publicAlt} data-astro-prefetch="hover">
					<span class="photo-card__media">
						<YohakuImage
							image={photo.data.image}
							alt={publicAlt}
							crop
							preview
							priority={index < 3}
							sizes="(max-width: 40rem) 33vw, (max-width: 64rem) 25vw, 20vw"
						/>
						{photo.data.kind === "video" && (
							<span class="video-badge">
								<CirclePlay size={14} strokeWidth={1.8} aria-hidden="true" />
								<span>動画</span>
							</span>
						)}
					</span>
					{displayTitle && <span class="photo-card__title">{displayTitle}</span>}
				</a>
				);
			})}
		</div>

		<nav class="album-pagination" aria-label="アルバムのページ（下部）">
            {result.page > 1 && <a href={pageHref(result.page - 1)} rel="prev">前の50件</a>}
            <span>{result.page} / {result.pageCount}ページ</span>
            {result.page < result.pageCount && <a href={pageHref(result.page + 1)} rel="next">次の50件</a>}
        </nav>
        <div class="photo-grid-size" data-photo-grid-size hidden>
			<Grid3x3 size={16} strokeWidth={1.65} aria-hidden="true" />
			<label class="sr-only" for="photo-grid-size">サムネイルの大きさ</label>
			<input
				id="photo-grid-size"
				type="range"
				min={PHOTO_GRID_SIZE.min}
				max={PHOTO_GRID_SIZE.max}
				step={PHOTO_GRID_SIZE.step}
				value={PHOTO_GRID_SIZE.defaultValue}
				data-photo-grid-size-input
				title="サムネイルの大きさ"
			/>
			<Grid2x2 size={17} strokeWidth={1.65} aria-hidden="true" />
		</div>
	</article>
</Photos>

<script>
	import { photoReturnKey } from "../../utils/photo-return.mjs";
	import {
		PHOTO_GRID_SIZE,
		normalizePhotoGridSize,
	} from "../../utils/photo-grid-size.mjs";

	const grid = document.querySelector<HTMLElement>("[data-photo-grid]");
	const control = document.querySelector<HTMLElement>("[data-photo-grid-size]");
	const input = control?.querySelector<HTMLInputElement>("[data-photo-grid-size-input]");

	if (grid && control && input) {
		grid.addEventListener("click", (event) => {
			const target = (event.target as Element).closest<HTMLAnchorElement>("[data-photo-id]");
			if (!target || !grid.dataset.albumId) return;
			try {
				sessionStorage.setItem(photoReturnKey(grid.dataset.albumId), JSON.stringify({
					albumId: grid.dataset.albumId, photoId: target.dataset.photoId, savedAt: Date.now(),
				}));
			} catch { /* Anchor-based return still works without storage. */ }
		});
		if (location.hash.startsWith("#photo-")) {
			const target = document.getElementById(location.hash.slice(1));
			if (target && grid.contains(target)) target.focus({ preventScroll: true });
		}
		const applySize = (value: unknown) => {
			const size = normalizePhotoGridSize(value);
			grid.dataset.customSize = "true";
			grid.style.setProperty("--photo-grid-min", `${size}px`);
			input.value = String(size);
			input.setAttribute("aria-valuetext", `サムネイル幅 ${size}px`);
			return size;
		};

		try {
			const storedSize = localStorage.getItem(PHOTO_GRID_SIZE.storageKey);
			if (storedSize !== null) applySize(storedSize);
		} catch {
			// Storage can be unavailable in privacy-restricted browsing contexts.
		}

		control.hidden = false;
		input.addEventListener("input", () => applySize(input.value));
		input.addEventListener("change", () => {
			const size = applySize(input.value);
			try {
				localStorage.setItem(PHOTO_GRID_SIZE.storageKey, String(size));
			} catch {
				// The visual control still works when persistence is unavailable.
			}
		});
	}
</script>
