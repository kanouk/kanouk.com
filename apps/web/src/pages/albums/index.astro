---
import { getEmDashCollection } from "emdash";
import { Images } from "lucide-astro";
import YohakuImage from "../../components/YohakuImage.astro";
import Photos from "../../layouts/Photos.astro";
import { sortAlbumsLikeSmugMug } from "../../utils/album-order.mjs";

const { entries: albums, cacheHint } = await getEmDashCollection("albums", {
	status: "published",
	orderBy: { published_at: "desc" },
	limit: 100,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const orderedAlbums = sortAlbumsLikeSmugMug(albums);
---

<Photos title="アルバム" description="kanouk.com の公開アルバム一覧">
	<section class="albums-page">
		<header class="page-header">
			<h1>アルバム</h1>
		</header>

		{orderedAlbums.length === 0 ? (
			<p class="empty">公開中のアルバムはまだありません。</p>
		) : (
			<div class="album-grid">
				{orderedAlbums.map((album, index) => (
					<a class="album-card" href={`/albums/${album.id}`}>
						{album.data.cover_image ? (
							<div class="cover"><YohakuImage image={album.data.cover_image} crop priority={index === 0} /></div>
						) : (
							<div class="cover placeholder" aria-hidden="true">
								<Images size={28} strokeWidth={1.25} />
							</div>
						)}
						<div class="album-overlay">
							<h2>{album.data.title}</h2>
						</div>
					</a>
				))}
			</div>
		)}
	</section>
</Photos>
