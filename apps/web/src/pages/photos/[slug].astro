---
import { getEmDashCollection, getEmDashEntry } from "emdash";
import { Image } from "emdash/ui";
import Photos from "../../layouts/Photos.astro";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

const { entry: photo, cacheHint: photoCache } = await getEmDashEntry("photos", slug);
if (!photo) return Astro.redirect("/404");
if (Astro.cache?.enabled) Astro.cache.set(photoCache);

const { entries: albums, cacheHint: albumCache } = await getEmDashCollection("albums", {
	status: "published",
	limit: 100,
});
if (Astro.cache?.enabled) Astro.cache.set(albumCache);
const album = albums.find((candidate) => candidate.data.id === photo.data.album);

const { entries: albumPhotos, cacheHint: albumPhotosCache } = await getEmDashCollection("photos", {
	status: "published",
	where: { album: photo.data.album },
	orderBy: { position: "asc" },
	limit: 100,
});
if (Astro.cache?.enabled) Astro.cache.set(albumPhotosCache);
const photoIndex = albumPhotos.findIndex((candidate) => candidate.data.id === photo.data.id);
const previousPhoto = photoIndex > 0 ? albumPhotos[photoIndex - 1] : undefined;
const nextPhoto = photoIndex >= 0 ? albumPhotos[photoIndex + 1] : undefined;
const videoStorageKey = photo.data.video?.meta?.storageKey;
const imageStorageKey = photo.data.image?.meta?.storageKey;
const posterSource =
	photo.data.image?.src ||
	(typeof imageStorageKey === "string"
		? `/_emdash/api/media/file/${encodeURIComponent(imageStorageKey)}`
		: undefined);
const videoSource =
	photo.data.kind === "video"
		? photo.data.video?.src ||
			photo.data.video?.url ||
			(typeof videoStorageKey === "string"
				? `/_emdash/api/media/file/${encodeURIComponent(videoStorageKey)}`
				: undefined)
		: undefined;

const capturedDate = photo.data.captured_at?.match(/^(\d{4})-(\d{2})-(\d{2})/);
const formattedDate = capturedDate
	? `${Number(capturedDate[1])}年${Number(capturedDate[2])}月${Number(capturedDate[3])}日`
	: undefined;

const latitude = photo.data.latitude;
const longitude = photo.data.longitude;
const hasLocation =
	typeof latitude === "number" &&
	Number.isFinite(latitude) &&
	latitude >= -90 &&
	latitude <= 90 &&
	typeof longitude === "number" &&
	Number.isFinite(longitude) &&
	longitude >= -180 &&
	longitude <= 180;
const mapEmbedUrl = hasLocation
	? (() => {
			const latitudeSpan = 0.008;
			const longitudeSpan = 0.012;
			const params = new URLSearchParams({
				bbox: [
					longitude - longitudeSpan,
					latitude - latitudeSpan,
					longitude + longitudeSpan,
					latitude + latitudeSpan,
				].join(","),
				layer: "mapnik",
				marker: `${latitude},${longitude}`,
			});
			return `https://www.openstreetmap.org/export/embed.html?${params}`;
		})()
	: undefined;
const mapLinkUrl = hasLocation
	? `https://www.openstreetmap.org/?mlat=${latitude}&mlon=${longitude}#map=15/${latitude}/${longitude}`
	: undefined;
---

<Photos
	title={photo.data.title}
	description={photo.data.caption}
	image={photo.data.image?.src}
	content={{ collection: "photos", id: photo.data.id, slug: photo.id }}
>
	<article class="photo-page">
		<a class="back" href={album ? `/albums/${album.id}` : "/albums"}>
			← {album?.data.title || "すべてのアルバム"}
		</a>
		<figure>
			<div class="media" {...photo.edit.image}>
				{
					videoSource ? (
						<video controls playsinline preload="metadata" poster={posterSource}>
							<source src={videoSource} type={photo.data.video?.mimeType || "video/mp4"} />
							動画を再生できないブラウザです。
						</video>
					) : (
						<Image image={photo.data.image} />
					)
				}
			</div>
			<figcaption>
				<h1 {...photo.edit.title}>{photo.data.title}</h1>
				{photo.data.caption && <p {...photo.edit.caption}>{photo.data.caption}</p>}
				{formattedDate && <time>{formattedDate}</time>}
			</figcaption>
		</figure>
		<nav class="photo-navigation" aria-label="アルバム内の写真移動">
			{previousPhoto ? <a href={`/photos/${previousPhoto.id}`}>← 前の写真</a> : <span />}
			{nextPhoto ? <a href={`/photos/${nextPhoto.id}`}>次の写真 →</a> : <span />}
		</nav>
		{
			mapEmbedUrl && mapLinkUrl && (
				<section class="location" aria-labelledby="location-title">
					<div class="location-heading">
						<h2 id="location-title">撮影場所</h2>
						<a href={mapLinkUrl} target="_blank" rel="noopener noreferrer">
							OpenStreetMapで見る
						</a>
					</div>
					<iframe
						src={mapEmbedUrl}
						title={`${photo.data.title}の撮影場所`}
						loading="lazy"
						referrerpolicy="no-referrer"
					/>
				</section>
			)
		}
	</article>
</Photos>
