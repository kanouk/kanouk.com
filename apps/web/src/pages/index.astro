---
import { getEmDashCollection, getTermsForEntries, getSiteSettings } from "emdash";
import BlogSidebar from "../components/BlogSidebar.astro";
import PostCard from "../components/PostCard.astro";
import Base from "../layouts/Base.astro";
import { getReadingTime } from "../utils/reading-time";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const POSTS_PER_PAGE = 10;

const [{ entries: posts, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: POSTS_PER_PAGE + 1,
	}),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const visiblePosts = posts.slice(0, POSTS_PER_PAGE);
const hasMorePosts = posts.length > POSTS_PER_PAGE;
const tagsByEntry = await getTermsForEntries(
	"posts",
	visiblePosts.map((post) => post.data.id),
	"tag",
);
---

<Base title={siteTitle} description={siteTagline}>
	{
		visiblePosts.length === 0 ? (
			<section class="empty-state">
				<h2>記事はまだありません</h2>
				<p>公開された記事がここに並びます。</p>
				<a href="/_emdash/admin/content/posts/new" class="btn">記事を作成</a>
			</section>
		) : (
			<div class="home-content">
				<div class="home-shell">
					<section class="home-main" aria-labelledby="latest-posts-title">
						<header class="section-header home-section-header">
							<h1 class="section-title" id="latest-posts-title">新着記事</h1>
							{hasMorePosts && <a href="/posts" class="section-link">すべての記事</a>}
						</header>
						<div class="home-posts">
							{visiblePosts.map((post) => (
								<PostCard
									variant="list"
									title={post.data.title ?? "無題"}
									excerpt={post.data.excerpt}
									featuredImage={post.data.featured_image}
									href={`/posts/${post.id}`}
									date={post.data.publishedAt ?? undefined}
									readingTime={getReadingTime(post.data.content)}
									tags={(tagsByEntry.get(post.data.id) ?? []).map((tag) => ({ slug: tag.slug, label: tag.label }))}
									bylines={post.data.bylines ?? []}
								/>
							))}
						</div>
					</section>
					<BlogSidebar latestDate={visiblePosts[0]?.data.publishedAt} />
				</div>
			</div>
		)
	}
</Base>
