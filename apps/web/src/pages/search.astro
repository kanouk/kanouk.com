---
export const prerender = false;

import { search } from "emdash";
import Base from "../layouts/Base.astro";

const query = Astro.url.searchParams.get("q")?.trim() || "";

// Use the FTS-backed search() API instead of loading every post and
// filtering in JS. FTS scales as the post count grows, returns ranked
// results, and handles tokenization/stemming. Templates that grep all
// post bodies in JS quickly become unusable past a few hundred posts.
const { items: results } = query
	? await search(query, { collections: ["posts"], limit: 30 })
	: { items: [] };
---

<Base
	title={query ? `「${query}」の検索結果` : "検索"}
	description="ブログ内の記事を検索"
>
	<section class="search-page">
		<p class="eyebrow">SEARCH</p>
		<h1 class="search-title">検索</h1>

		<form method="get" action="/search" class="search-form">
			<input
				type="search"
				name="q"
				value={query}
				placeholder="検索語を入力"
				class="search-input"
				autofocus
			/>
			<button type="submit" class="search-button">検索</button>
		</form>

		{
			query && (
				<p class="search-summary">
					{results.length === 0
						? `「${query}」に一致する記事はありませんでした。`
						: `「${query}」の検索結果：${results.length.toLocaleString("ja-JP")}件`}
				</p>
			)
		}

		{
			results.length > 0 && (
				<ol class="search-results">
					{results.map((result) => (
						<li class="search-result">
							<a
								href={`/posts/${result.id}`}
								class="result-link"
							>
								<h2 class="result-title">
									{result.title ?? "無題"}
								</h2>
								{result.snippet && (
									<p class="result-snippet" set:html={result.snippet} />
								)}
							</a>
						</li>
					))}
				</ol>
			)
		}

		{!query && <p class="search-hint">タイトルと本文から検索できます。</p>}
	</section>
</Base>
