---
export const prerender = false;

import { search } from "emdash";
import { Images, Search } from "lucide-astro";
import YohakuImage from "../components/YohakuImage.astro";
import Photos from "../layouts/Photos.astro";
import { photoPath } from "../utils/photo-url.mjs";
import { looksLikeCameraNumber, looksLikeSourceFilename } from "../utils/photo-display.mjs";
import { searchResultImages } from "../utils/search-images";

const query = Astro.url.searchParams.get("q")?.trim() || "";
const isPreviewHost = Astro.url.hostname.endsWith("workers.dev") || Astro.url.hostname === "localhost";
const searchUrl = isPreviewHost ? "/photo-search" : "/search";
const { items: results } = query
	? await search(query, { collections: ["albums", "photos"], limit: 40 })
	: { items: [] };
const images = await searchResultImages(results).catch(() => new Map<string, unknown>());
const albumHits = results.filter((result) => result.collection === "albums");
// Only photos shown in a public album (the image map leaves out the rest).
const photoHits = results.filter((result) => result.collection !== "albums" && images.has(result.id));
// The snippet repeats the title for most photos; show it only when it adds words.
const plainSnippet = (snippet: string | null | undefined) => snippet?.replace(/<[^>]+>/g, "").trim() ?? "";
const extraSnippet = (result: { title?: string | null; snippet?: string | null }) =>
	result.snippet && plainSnippet(result.snippet) !== (result.title ?? "").trim() ? result.snippet : "";

const resultUrl = (collection: string, slug: string | null, id: string) =>
	collection === "albums"
		? `/albums/${slug ?? id}`
		: photoPath(slug ?? id);
// A file name or camera number is not a title worth showing.
const meaningfulTitle = (title: string | null | undefined) =>
	title && !looksLikeCameraNumber(title) && !looksLikeSourceFilename(title) ? title : "";
---

<Photos
	title={query ? `「${query}」の検索結果` : "写真を検索"}
	description="公開アルバムと写真を検索"
>
	<section class="photo-search-page">
		<header class="page-header">
			<h1>写真を検索</h1>
			<p>アルバム名、説明、写真のタイトルやキャプションから探せます。</p>
		</header>

		<form method="get" action={searchUrl} class="photo-search-form">
			<label class="sr-only" for="photo-search-query">検索語</label>
			<Search size={18} strokeWidth={1.75} aria-hidden="true" />
			<input
				id="photo-search-query"
				type="search"
				name="q"
				value={query}
				placeholder="場所、年月、写真の名前など"
				autocomplete="off"
				autofocus={!query}
			/>
			<button type="submit">検索</button>
		</form>

		{query && (
			<p class="photo-search-summary" aria-live="polite">
				{albumHits.length + photoHits.length === 0
					? `「${query}」に一致する公開写真はありませんでした。`
					: `${(albumHits.length + photoHits.length).toLocaleString("ja-JP")}件見つかりました`}
			</p>
		)}

		{albumHits.length > 0 && (
			<section class="photo-search-section" aria-labelledby="photo-search-albums">
				<h2 id="photo-search-albums">アルバム <span>{albumHits.length}</span></h2>
				<ol class="photo-search-albums">
					{albumHits.map((result) => (
						<li>
							<a href={resultUrl(result.collection, result.slug, result.id)}>
								<span class="photo-search-albums__cover">
									{images.get(result.id)
										? <YohakuImage image={images.get(result.id) as any} crop preview sizes="4.5rem" />
										: <Images size={20} strokeWidth={1.5} aria-hidden="true" />}
								</span>
								<span class="photo-search-result-copy">
									<strong>{meaningfulTitle(result.title) || "無題のアルバム"}</strong>
									{extraSnippet(result) && <span set:html={extraSnippet(result)} />}
								</span>
							</a>
						</li>
					))}
				</ol>
			</section>
		)}

		{photoHits.length > 0 && (
			<section class="photo-search-section" aria-labelledby="photo-search-photos">
				<h2 id="photo-search-photos">写真 <span>{photoHits.length}</span></h2>
				<ol class="photo-search-photos">
					{photoHits.map((result) => {
						const title = meaningfulTitle(result.title);
						return (
						<li>
							<a href={resultUrl(result.collection, result.slug, result.id)} aria-label={title || "写真"}>
								<span class="photo-search-photos__media">
									{images.get(result.id) && <YohakuImage image={images.get(result.id) as any} alt={title || "写真"} crop preview sizes="(max-width: 40rem) calc((100vw - 2.5rem) / 3), 12rem" />}
								</span>
								{title && <span class="photo-search-photos__title">{title}</span>}
							</a>
						</li>
						);
					})}
				</ol>
			</section>
		)}
	</section>
</Photos>
