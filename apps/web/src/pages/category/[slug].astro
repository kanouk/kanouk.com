---
import {
	getTerm,
	getEmDashCollection,
	getTermsForEntries,
} from "emdash";
import Base from "../../layouts/Base.astro";
import ArchivePagination from "../../components/ArchivePagination.astro";
import PostCard from "../../components/PostCard.astro";
import { getPostExcerpt, getReadingTime } from "../../utils/reading-time";
import { routeSlugCandidates } from "../../utils/route-slug";

const slugCandidates = routeSlugCandidates(Astro.params.slug);
let term = slugCandidates[0] ? await getTerm("category", slugCandidates[0]) : null;
for (const legacySlug of slugCandidates.slice(1)) {
	if (term) break;
	term = await getTerm("category", legacySlug);
}

if (!term) {
	return Astro.redirect("/404");
}

const PAGE_SIZE = 24;
const requestedPage = Number.parseInt(Astro.url.searchParams.get("page") ?? "1", 10);
const page = Number.isSafeInteger(requestedPage) && requestedPage > 0 ? requestedPage : 1;
const basePath = `/category/${encodeURIComponent(Astro.params.slug ?? term.slug)}`;

const { entries: posts, hasMore = false, cacheHint } = await getEmDashCollection("posts", {
	where: { category: term.slug },
	orderBy: { published_at: "desc" },
	limit: PAGE_SIZE,
	offset: (page - 1) * PAGE_SIZE,
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Single batched query for tags on every post in this category, rather
// than calling getEntryTerms() per post (which would be one round-trip
// per post).
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);
const filteredPosts = posts.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
}));
---

<Base title={`${term.label}の記事`} description={`${term.label}カテゴリーの記事一覧`}>
	<section class="archive-section">
		<header class="archive-header">
			<span class="archive-label">カテゴリー</span>
			<h1 class="archive-title">{term.label}</h1>
			<p class="archive-count">
				{page > 1 ? `${page}ページ目・` : ""}{filteredPosts.length.toLocaleString("ja-JP")}件を表示
			</p>
		</header>

		{
			filteredPosts.length === 0 ? (
				<p class="no-posts">このカテゴリーの記事はまだありません。</p>
			) : (
				<div class="posts-grid">
					{filteredPosts.map(({ post, tags }, index) => (
						<PostCard
							title={post.data.title}
							excerpt={getPostExcerpt(post.data.excerpt, post.data.content)}
							featuredImage={post.data.featured_image}
							href={`/posts/${post.data.id}`}
							date={post.data.publishedAt ?? undefined}
							readingTime={getReadingTime(post.data.content)}
							categories={[{ slug: term.slug, label: term.label }]}
							tags={tags.map((t) => ({ slug: t.slug, label: t.label }))}
							priority={page === 1 && index < 2}
						/>
					))}
				</div>
			)
		}
		<ArchivePagination page={page} hasMore={hasMore} basePath={basePath} />
	</section>
</Base>
