---
import {
	getEmDashEntry,
	getEmDashCollection,
	getEntryTerms,
	getTermsForEntries,
	getSeoMeta,
	getSiteSettings,
	MediaRepository,
} from "emdash";
import { getDb } from "emdash/runtime";
import {
	PortableText,
} from "emdash/ui";
import { Comments, CommentForm } from "emdash/ui/comments";
import { Search } from "lucide-astro";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import PostArchiveNav from "../../components/PostArchiveNav.astro";
import ProfileCard from "../../components/ProfileCard.astro";
import SidebarTaxonomies from "../../components/SidebarTaxonomies.astro";
import YohakuPortableImage from "../../components/YohakuPortableImage.astro";
import {
	resolveArticleSocial,
	type ArticleSocialDatabase,
} from "../../utils/article-social";
import { getPostExcerpt, getReadingTime } from "../../utils/reading-time";
import { calculateAge } from "../../utils/author-age.mjs";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import { routeSlugCandidates } from "../../utils/route-slug";
import { env } from "virtual:emdash/env";
import { articlePhotoLinks } from "../../utils/article-photo-links.mjs";
import {
	comparableAlbumHref,
	legacySourceUrlVariants,
	normalizeLegacyAlbumCards,
} from "../../utils/legacy-album-cards.mjs";

const slugCandidates = routeSlugCandidates(Astro.params.slug);
const slug = slugCandidates[0];

if (!slug) {
	return Astro.redirect("/404");
}

let postResult = await getEmDashEntry("posts", slug);
for (const legacySlug of slugCandidates.slice(1)) {
	if (postResult.entry) break;
	postResult = await getEmDashEntry("posts", legacySlug);
}
const { entry: post, cacheHint, isPreview } = postResult;

if (!post) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const canonicalPostPath = `/posts/${post.data.id}`;
if (!isPreview && slug !== post.data.id) {
	return Astro.redirect(canonicalPostPath, 308);
}

const legacyAlbumContent = await normalizeLegacyAlbumCards(
	post.data.content ?? [],
	async (reference, sourceHref) => {
		if (reference.kind === "current") {
			const result = await getEmDashEntry("albums", reference.key);
			if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);
			return result.entry?.data.status === "published" ? result.entry.data.id : "";
		}
		const result = await getEmDashCollection("albums", {
			status: "published",
			where: { source_url: legacySourceUrlVariants(sourceHref) },
			limit: 3,
		});
		if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);
		const sourceKey = comparableAlbumHref(sourceHref);
		const matches = result.entries.filter((album) =>
			album.data.status === "published" &&
			comparableAlbumHref(album.data.source_url) === sourceKey
		);
		const uniqueMatches = new Map(matches.map((album) => [album.data.id, album]));
		return uniqueMatches.size === 1 ? uniqueMatches.values().next().value?.data.id ?? "" : "";
	},
);
const articleContent = legacyAlbumContent.content as NonNullable<typeof post.data.content>;
if (!env?.DB) throw new Error("Cloudflare D1 binding DB is unavailable");
const socialDatabase = env.DB as ArticleSocialDatabase;

// WordPress-era portable image snapshots can omit dimensions even though the
// canonical media row has them. Start the single lookup before the remaining
// page queries so the LCP image can reserve its exact aspect ratio without
// extending the critical path in the common case.
const firstPortableImage = articleContent.find(
	(block) => block._type === "image",
) as
	| {
			_type: "image";
			asset?: { _ref?: string };
			width?: number;
			height?: number;
	  }
	| undefined;
const firstPortableImageId = firstPortableImage?.asset?._ref;
const firstImageDimensionsPromise =
	firstPortableImage &&
	firstPortableImageId &&
	(!firstPortableImage.width || !firstPortableImage.height)
		? (async () => {
				const media = await new MediaRepository(await getDb()).findById(firstPortableImageId);
				return media?.width && media.height
					? { width: media.width, height: media.height }
					: undefined;
			})().catch(() => undefined)
		: Promise.resolve(undefined);

// Social images must resolve to a currently public media source. In particular,
// a stale WordPress SEO URL never bypasses the published-media boundary.
const articleSocial = await resolveArticleSocial(socialDatabase, {
	id: post.id,
	data: { ...post.data, content: articleContent },
}, { origin: Astro.url.origin, isPreview });
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());

// Generate SEO meta from content
const generatedSeo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: canonicalPostPath,
	defaultDescription: articleSocial.description || undefined,
	defaultOgImage: articleSocial.imageUrl,
});
// The stored WordPress canonical can contain a percent-encoded Japanese slug.
// The public contract is the stable EmDash content ID; legacy slugs redirect.
const seo = {
	...generatedSeo,
	canonical: new URL(canonicalPostPath, "https://blog.kanouk.com").toString(),
	description: articleSocial.description || generatedSeo.description,
	ogDescription: articleSocial.description || generatedSeo.ogDescription,
	ogImage: articleSocial.imageUrl,
};

// Bylines are already hydrated by getEmDashEntry
const bylines = post.data.bylines ?? [];
const authorAgeAtPublication = calculateAge(
	"1977-06-18",
	post.data.publishedAt ?? post.data.createdAt,
);

// Get reading time
const readingTime = getReadingTime(articleContent);
const firstImageDimensions = await firstImageDimensionsPromise;
const imagePhotoLinks = await articlePhotoLinks(env.DB, articleContent);
if (Astro.cache?.enabled) Astro.cache.set({ tags: ["photos", "albums"] });
const photoOrigin = ["localhost", "127.0.0.1"].includes(Astro.url.hostname) || Astro.url.hostname.endsWith("workers.dev") ? "" : "https://photos.kanouk.com";
let firstPortableImagePrioritized = false;
const prioritizedContent = articleContent.map((block) => {
	const mediaId = (block as { asset?: { _ref?: string } }).asset?._ref;
	const photoId = block._type === "image" && mediaId ? imagePhotoLinks.get(mediaId) : undefined;
	const linkedBlock = photoId ? { ...block, link: `${photoOrigin}/p/${encodeURIComponent(photoId)}` } : block;
	if (!firstPortableImagePrioritized && (block._type === "image" || block._type === "gallery")) {
		firstPortableImagePrioritized = true;
		return block === firstPortableImage
			? { ...linkedBlock, ...firstImageDimensions, _yohakuPriority: true }
			: { ...linkedBlock, _yohakuPriority: true };
	}
	return linkedBlock;
});

const [categories, tags, recentPostsResult] = await Promise.all([
 getEntryTerms("posts", post.data.id, "category"),
 getEntryTerms("posts", post.data.id, "tag"),
 getEmDashCollection("posts", {orderBy:{published_at:"desc"},limit:4}),
]);
if (Astro.cache?.enabled) Astro.cache.set(recentPostsResult.cacheHint);
const recentPosts = recentPostsResult.entries;
const otherPosts = recentPosts.filter((p) => p.id !== post.id).slice(0, 3);

// Single batched query for related-posts tags, rather than one
// getEntryTerms() call per related post.
const [otherCategoriesByEntry, otherTagsByEntry] = await Promise.all([
	getTermsForEntries("posts", otherPosts.map((p) => p.data.id), "category"),
	getTermsForEntries("posts", otherPosts.map((p) => p.data.id), "tag"),
]);
const otherPostsWithTags = otherPosts.map((p) => ({
	post: p,
	categories: otherCategoriesByEntry.get(p.data.id) ?? [],
	tags: otherTagsByEntry.get(p.data.id) ?? [],
}));

const publishDate =
	post.data.publishedAt?.toLocaleDateString("ja-JP", {
		year: "numeric",
		month: "long",
		day: "numeric",
		}) ?? null;
const titleSegments = Array.from(
	new Intl.Segmenter("ja", { granularity: "word" }).segment(post.data.title),
	({ segment }) => segment,
);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	content={{ collection: "posts", id: post.data.id, slug: post.id }}
>
	<article class="article">
		<header class="article-lead">
			{
				publishDate && (
					<time class="article-published" datetime={post.data.publishedAt?.toISOString()}>
						{publishDate}
					</time>
				)
			}
			<h1 class="article-title" {...post.edit.title}>
				{titleSegments.map((segment) => <span class="article-title__segment">{segment}</span>)}
			</h1>
			<div class="article-meta" aria-label="記事情報">
				{
					categories.length > 0 && (
						<span class="article-meta-categories">
							{categories.map((category) => (
								<a href={`/category/${category.slug}`} class="card-category">{category.label}</a>
							))}
						</span>
					)
				}
				{
					bylines.length > 0 && (
						<>
							{categories.length > 0 && <span class="meta-dot" />}
							<span class="article-meta-byline">
								{bylines.map((credit, i) => (
									<>
										{i > 0 && ", "}
										{i === 0 ? `${credit.byline.displayName}（${authorAgeAtPublication}歳）` : credit.byline.displayName}
									</>
								))}
							</span>
						</>
					)
				}
				{(categories.length > 0 || bylines.length > 0) && <span class="meta-dot" />}
				<span>{readingTime}分で読めます</span>
			</div>
			{
				post.data.excerpt && (
					<p class="article-excerpt" {...post.edit.excerpt}>{post.data.excerpt}</p>
				)
			}
		</header>

		{/* Reading column plus a separate discovery rail. */}
		<div class="article-grid">
			{/* Main content */}
			<div class="article-main">
				<nav class="toc article-toc" aria-label="目次" hidden>
					<h2 class="toc-title">目次</h2>
					<div class="toc-content" id="toc-content">
						<!-- Populated by JS -->
					</div>
				</nav>
				<div class="article-content">
					<PortableText
						value={prioritizedContent}
						components={{ type: { image: YohakuPortableImage } }}
					/>
				</div>

				{tags.length > 0 && (
					<nav class="article-footer-tags" aria-label="記事のタグ">
						<span class="article-footer-tags__label">タグ</span>
						<span class="article-footer-tags__list">
							{tags.map((tag) => (
								<a href={`/tag/${tag.slug}`} class="article-footer-tag">#{tag.label}</a>
							))}
						</span>
					</nav>
				)}

				<div class="article-comments">
					<Comments collection="posts" contentId={post.data.id} threaded />
					<CommentForm collection="posts" contentId={post.data.id} />
				</div>
			</div>

			{/* Right gutter: profile + compact content discovery */}
			<aside class="article-sidebar">
				<div class="sidebar-sticky">
					<ProfileCard />
					<div class="sidebar-widgets">
						<PostArchiveNav date={post.data.publishedAt} />
						<section class="widget">
							<h3 class="widget__title">検索</h3>
							<div class="widget__content">
								<form method="get" action="/search" class="widget-search">
									<input
										type="search"
										name="q"
										placeholder="記事を検索"
										aria-label="記事を検索"
										class="widget-search__input"
									/>
									<button type="submit" class="widget-search__button" aria-label="検索する">
										<Search size={15} strokeWidth={1.8} aria-hidden="true" />
									</button>
								</form>
							</div>
						</section>
						<SidebarTaxonomies />
					</div>
				</div>
			</aside>
		</div>
	</article>

	{
		otherPostsWithTags.length > 0 && (
			<section class="more-posts">
				<div class="more-inner">
					<h2 class="more-title">続けて読む</h2>
					<div class="more-grid">
						{otherPostsWithTags.map(
							({ post: p, categories: postCategories, tags: postTags }) => (
								<PostCard
									title={p.data.title}
									excerpt={getPostExcerpt(p.data.excerpt, p.data.content)}
									featuredImage={p.data.featured_image}
									href={`/posts/${p.data.id}`}
									date={p.data.publishedAt ?? undefined}
									readingTime={getReadingTime(p.data.content)}
									categories={postCategories.map((category) => ({ slug: category.slug, label: category.label }))}
									tags={postTags.map((t) => ({ slug: t.slug, label: t.label }))}
								/>
							)
						)}
					</div>
				</div>
			</section>
		)
	}

	<script>
		// Build table of contents from h2/h3 headings
		function buildToc() {
			const content = document.querySelector(".article-content");
			const tocContainer = document.getElementById("toc-content");
			if (!content || !tocContainer) return;

			const headings = content.querySelectorAll("h2, h3");
			if (headings.length === 0) {
				return;
			}

			const toc = tocContainer.closest(".toc") as HTMLElement | null;
			if (toc) toc.hidden = false;

			const list = document.createElement("ul");
			list.className = "toc-list";

			headings.forEach((heading, index) => {
				// Add ID if missing
				if (!heading.id) {
					heading.id = `heading-${index}`;
				}

				const li = document.createElement("li");
				li.className =
					heading.tagName === "H3" ? "toc-item toc-item--nested" : "toc-item";

				const link = document.createElement("a");
				link.href = `#${heading.id}`;
				link.className = "toc-link";
				link.textContent = heading.textContent;

				li.appendChild(link);
				list.appendChild(li);
			});

			tocContainer.appendChild(list);

			// Highlight current section on scroll
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						const id = entry.target.id;
						const link = tocContainer.querySelector(`a[href="#${id}"]`);
						if (link) {
							if (entry.isIntersecting) {
								tocContainer
									.querySelectorAll(".toc-link")
									.forEach((l) => l.classList.remove("active"));
								link.classList.add("active");
							}
						}
					});
				},
				{ rootMargin: "-80px 0px -80% 0px" }
			);

			headings.forEach((heading) => observer.observe(heading));
		}

		buildToc();
	</script>
</Base>
