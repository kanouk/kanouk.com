---
import { contentUnavailable, redirectNotFound } from "../../utils/route-guards";
import { promoteXPostLinks } from "../../utils/x-post-links.mjs";
import {
	getEmDashEntry,
	getEmDashCollection,
	getEntryTerms,
	getTermsForEntries,
	getSeoMeta,
	getSiteSettings,
	MediaRepository,
} from "emdash";
import { getDb } from "emdash/runtime";
import {
	PortableText,
} from "emdash/ui";
import { Comments, CommentForm } from "emdash/ui/comments";
import { ArrowLeft, ArrowRight, ChevronDown, ChevronRight, ChevronUp, List, Search } from "lucide-astro";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import PostArchiveNav from "../../components/PostArchiveNav.astro";
import ProfileCard from "../../components/ProfileCard.astro";
import YohakuImage from "../../components/YohakuImage.astro";
import SidebarTaxonomies from "../../components/SidebarTaxonomies.astro";
import YohakuPortableImage from "../../components/YohakuPortableImage.astro";
import {
	resolveArticleSocial,
	type ArticleSocialDatabase,
} from "../../utils/article-social";
import { postCoverImages } from "../../utils/post-covers";
import { getPostExcerpt, getReadingTime } from "../../utils/reading-time";
import { calculateAge } from "../../utils/author-age.mjs";
import { siteDateLabel } from "../../utils/photo-date.mjs";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import { titlePhrases } from "../../utils/title-phrases.mjs";
import { routeSlugCandidates } from "../../utils/route-slug";
import { env } from "virtual:emdash/env";
import { articlePhotoLinks } from "../../utils/article-photo-links.mjs";
import {
	comparableAlbumHref,
	legacySourceUrlVariants,
	normalizeLegacyAlbumCards,
} from "../../utils/legacy-album-cards.mjs";
import { startSharedBlogQueries } from "../../utils/shared-queries";
import { sharedPostList, termListKey } from "../../utils/post-list-memo.mjs";
import { adjacentPostId } from "../../utils/adjacent-post.mjs";
import { visibleTags } from "../../utils/hidden-tags.mjs";
import {
	pickRelatedPosts,
	relatedCandidateLimit,
	relatedTagSlugs,
	termSlugs,
} from "../../utils/related-posts.mjs";

const slugCandidates = routeSlugCandidates(Astro.params.slug);
const slug = slugCandidates[0];

if (!slug) {
	return redirectNotFound(Astro);
}

// Footer pages, sidebar taxonomies and archive months do not depend on the
// article: start them with the article lookup instead of after the body renders.
startSharedBlogQueries(Astro.locals);
let postResult = await getEmDashEntry("posts", slug);
for (const legacySlug of slugCandidates.slice(1)) {
	if (postResult.entry) break;
	postResult = await getEmDashEntry("posts", legacySlug);
}
const { entry: post, cacheHint, isPreview, error: postError } = postResult;

if (!post) {
	return postError ? contentUnavailable(Astro, postError) : redirectNotFound(Astro);
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const canonicalPostPath = `/posts/${post.data.id}`;
if (!isPreview && slug !== post.data.id) {
	return Astro.redirect(canonicalPostPath, 308);
}

// Queries that do not depend on the article body start now and run alongside
// the body-dependent ones below (each D1 round trip adds latency on a cold page).
const siteSettingsPromise = getSiteSettings();
const adjacentPost = async (direction: "older" | "newer") => {
	if (!post.data.publishedAt || !env?.DB) return undefined;
	// Find the neighbour with one index row, then load only that entry.
	const neighbourId = await adjacentPostId(env.DB, post.data.publishedAt.toISOString(), direction);
	if (!neighbourId) return undefined;
	const { entry } = await getEmDashEntry("posts", neighbourId);
	return entry?.data.status === "published" ? entry : undefined;
};
// getEmDashEntry folds the article's terms into its own query and primes the
// request cache, so these resolve without another D1 round trip. The related
// candidates below can therefore start now, in parallel with each other and
// with the rest of the sidebar data, instead of after it. The candidate lists
// do not depend on this article, so articles sharing a tag or category share
// one read for a few minutes (sharedPostList).
const tagTermsPromise = getEntryTerms("posts", post.data.id, "tag");
const categoryTermsPromise = getEntryTerms("posts", post.data.id, "category");
const relatedLimit = relatedCandidateLimit();
const relatedByTagPromise = tagTermsPromise.then(async (terms) => {
	// Hidden housekeeping tags never make posts "related"; no tags, no query.
	const slugs = relatedTagSlugs(terms);
	if (slugs.length === 0) return [];
	const result = await sharedPostList(termListKey("tag", slugs, relatedLimit), () => getEmDashCollection("posts", {
		status: "published",
		where: { tag: slugs },
		orderBy: { published_at: "desc" },
		limit: relatedLimit,
	}));
	if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);
	return result.entries;
});
const relatedByCategoryPromise = categoryTermsPromise.then(async (terms) => {
	const slugs = termSlugs(terms);
	if (slugs.length === 0) return [];
	const result = await sharedPostList(termListKey("category", slugs, relatedLimit), () => getEmDashCollection("posts", {
		status: "published",
		where: { category: slugs },
		orderBy: { published_at: "desc" },
		limit: relatedLimit,
	}));
	if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);
	return result.entries;
});
const sidebarDataPromise = Promise.all([
	tagTermsPromise,
	sharedPostList(`recent:${relatedLimit}`, () => getEmDashCollection("posts", { status: "published", orderBy: { published_at: "desc" }, limit: relatedLimit })),
	categoryTermsPromise,
	adjacentPost("older"),
	adjacentPost("newer"),
	relatedByTagPromise,
	relatedByCategoryPromise,
]);

const legacyAlbumContent = await normalizeLegacyAlbumCards(
	post.data.content ?? [],
	async (reference, sourceHref) => {
		if (reference.kind === "current") {
			const result = await getEmDashEntry("albums", reference.key);
			if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);
			return result.entry?.data.status === "published" ? result.entry.data.id : "";
		}
		const result = await getEmDashCollection("albums", {
			status: "published",
			where: { source_url: legacySourceUrlVariants(sourceHref) },
			limit: 3,
		});
		if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);
		const sourceKey = comparableAlbumHref(sourceHref);
		const matches = result.entries.filter((album) =>
			album.data.status === "published" &&
			comparableAlbumHref(album.data.source_url) === sourceKey
		);
		const uniqueMatches = new Map(matches.map((album) => [album.data.id, album]));
		return uniqueMatches.size === 1 ? uniqueMatches.values().next().value?.data.id ?? "" : "";
	},
);
// A bare X post URL on its own line renders as the post (render-time only; stored content is untouched).
const articleContent = promoteXPostLinks(legacyAlbumContent.content) as NonNullable<typeof post.data.content>;
if (!env?.DB) throw new Error("Cloudflare D1 binding DB is unavailable");
const socialDatabase = env.DB as ArticleSocialDatabase;

// WordPress-era portable image snapshots can omit dimensions even though the
// canonical media row has them. Start the single lookup before the remaining
// page queries so the LCP image can reserve its exact aspect ratio without
// extending the critical path in the common case.
const firstPortableImage = articleContent.find(
	(block) => block._type === "image",
) as
	| {
			_type: "image";
			asset?: { _ref?: string };
			width?: number;
			height?: number;
	  }
	| undefined;
const firstPortableImageId = firstPortableImage?.asset?._ref;
const firstImageDimensionsPromise =
	firstPortableImage &&
	firstPortableImageId &&
	(!firstPortableImage.width || !firstPortableImage.height)
		? (async () => {
				const media = await new MediaRepository(await getDb()).findById(firstPortableImageId);
				return media?.width && media.height
					? { width: media.width, height: media.height }
					: undefined;
			})().catch(() => undefined)
		: Promise.resolve(undefined);

// Social images must resolve to a currently public media source. In particular,
// a stale WordPress SEO URL never bypasses the published-media boundary.
const [articleSocial, siteSettings, firstImageDimensions, imagePhotoLinks, sidebarData] = await Promise.all([
	resolveArticleSocial(socialDatabase, {
		id: post.id,
		data: { ...post.data, content: articleContent },
	}, { origin: Astro.url.origin, isPreview }),
	siteSettingsPromise,
	firstImageDimensionsPromise,
	articlePhotoLinks(env.DB, articleContent),
	sidebarDataPromise,
]);
const [allTags, recentPostsResult, categories, olderPost, newerPost, relatedByTag, relatedByCategory] = sidebarData;
const tags: typeof allTags = visibleTags(allTags);
const { siteTitle } = resolveBlogSiteIdentity(siteSettings);

// Generate SEO meta from content
const generatedSeo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: canonicalPostPath,
	defaultDescription: articleSocial.description || undefined,
	defaultOgImage: articleSocial.imageUrl,
});
// The stored WordPress canonical can contain a percent-encoded Japanese slug.
// The public contract is the stable EmDash content ID; legacy slugs redirect.
const seo = {
	...generatedSeo,
	canonical: new URL(canonicalPostPath, "https://blog.kanouk.com").toString(),
	description: articleSocial.description || generatedSeo.description,
	ogDescription: articleSocial.description || generatedSeo.ogDescription,
	ogImage: articleSocial.imageUrl,
};

// Bylines are already hydrated by getEmDashEntry. Only signed-in admins see
// them; their requests bypass the shared cache (src/middleware.ts).
const bylines = post.data.bylines ?? [];
const showByline = Boolean(Astro.locals.user) && bylines.length > 0;
const authorAgeAtPublication = calculateAge(
	"1977-06-18",
	post.data.publishedAt ?? post.data.createdAt,
);

// Get reading time
const readingTime = getReadingTime(articleContent);
if (Astro.cache?.enabled) Astro.cache.set({ tags: ["photos", "albums"] });
const photoOrigin = ["localhost", "127.0.0.1"].includes(Astro.url.hostname) || Astro.url.hostname.endsWith("workers.dev") ? "" : "https://photos.kanouk.com";
let firstPortableImagePrioritized = false;
const prioritizedContent = articleContent.map((block) => {
	const mediaId = (block as { asset?: { _ref?: string } }).asset?._ref;
	const photoId = block._type === "image" && mediaId ? imagePhotoLinks.get(mediaId) : undefined;
	const linkedBlock = photoId ? { ...block, link: `${photoOrigin}/p/${encodeURIComponent(photoId)}` } : block;
	if (!firstPortableImagePrioritized && (block._type === "image" || block._type === "gallery")) {
		firstPortableImagePrioritized = true;
		return block === firstPortableImage
			? { ...linkedBlock, ...firstImageDimensions, _yohakuPriority: true }
			: { ...linkedBlock, _yohakuPriority: true };
	}
	return linkedBlock;
});

if (Astro.cache?.enabled) Astro.cache.set(recentPostsResult.cacheHint);
// 「続けて読む」: posts sharing a tag first (tags are specific here), then the
// same category (categories are broad), then the newest posts as filler.
const otherPosts = pickRelatedPosts({
	current: post,
	tiers: [relatedByTag, relatedByCategory, recentPostsResult.entries],
});

// Single batched query for related-posts tags, rather than one
// getEntryTerms() call per related post.
const [otherTagsByEntry, otherCovers] = await Promise.all([
	getTermsForEntries("posts", otherPosts.map((p) => p.data.id), "tag"),
	postCoverImages([...otherPosts, ...(olderPost ? [olderPost] : []), ...(newerPost ? [newerPost] : [])]),
]);
const otherPostsWithTags = otherPosts.map((p) => {
	const postTags: typeof allTags = visibleTags(otherTagsByEntry.get(p.data.id) ?? []);
	return { post: p, tags: postTags };
});

const publishDate = post.data.publishedAt ? siteDateLabel(post.data.publishedAt) : null;
// Phrases, not words: a particle or closing bracket never starts a line of the title.
const titleSegments = titlePhrases(post.data.title);
const olderCover = olderPost ? otherCovers.get(olderPost.data.id) : undefined;
const newerCover = newerPost ? otherCovers.get(newerPost.data.id) : undefined;
// Thumbnails only when every card in the pager has one, so the two cards keep the same shape.
const showPagerThumbs = Boolean((!olderPost || olderCover) && (!newerPost || newerCover));
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	content={{ collection: "posts", id: post.data.id, slug: post.id }}
>
	<article class="article">
		<header class="article-lead">
			<nav class="article-breadcrumb" aria-label="パンくずリスト">
				<a href="/">ホーム</a>
				{categories[0] && (
					<>
						<ChevronRight size={12} strokeWidth={1.8} aria-hidden="true" />
						<a href={`/category/${categories[0].slug}`}>{categories[0].label}</a>
					</>
				)}
			</nav>
			<h1 class="article-title" {...post.edit.title}>
				{titleSegments.map((segment) =>
					// Keep phrases together, but let a long unbroken word (URL, identifier) wrap.
					segment.length > 16 ? segment : <span class="article-title__segment">{segment}</span>
				)}
			</h1>
			<div class="article-meta" aria-label="記事情報">
				{
					publishDate && (
						<>
							<time datetime={post.data.publishedAt?.toISOString()}>{publishDate}</time>
							<span class="meta-dot" />
						</>
					)
				}
				{
					showByline && (
						<>
							<span class="article-meta-byline">
								{bylines.map((credit, i) => (
									<>
										{i > 0 && ", "}
										{i === 0 ? `${credit.byline.displayName}（${authorAgeAtPublication}歳）` : credit.byline.displayName}
									</>
								))}
							</span>
							<span class="meta-dot" />
						</>
					)
				}
				<span>{readingTime}分で読む</span>
			</div>
			{
				post.data.excerpt && (
					<p class="article-excerpt" {...post.edit.excerpt}>{post.data.excerpt}</p>
				)
			}
		</header>

		{/* Reading column plus a separate discovery rail. */}
		<div class="article-grid">
			{/* Main content */}
			<div class="article-main">
				<nav class="toc article-toc" aria-label="目次" hidden>
					<details class="toc-details" open>
						<summary class="toc-summary">
							<span class="toc-title">目次</span>
							<ChevronDown class="toc-chevron" size={16} strokeWidth={1.75} aria-hidden="true" />
						</summary>
						<div class="toc-content" id="toc-content">
							<!-- Populated by JS -->
						</div>
					</details>
				</nav>
				<div class="article-content">
					<PortableText
						value={prioritizedContent}
						components={{ type: { image: YohakuPortableImage } }}
					/>
				</div>

				{(categories.length > 0 || tags.length > 0) && (
					<nav class="article-footer-tags" aria-label="記事の分類">
						{categories.length > 0 && (
							<>
								<span class="article-footer-tags__label">カテゴリー</span>
								<span class="article-footer-tags__list">
									{categories.map((category) => (
										<a href={`/category/${category.slug}`} class="article-footer-tag">{category.label}</a>
									))}
								</span>
							</>
						)}
						{tags.length > 0 && (
							<>
								<span class="article-footer-tags__label">タグ</span>
								<span class="article-footer-tags__list">
									{tags.map((tag) => (
										<a href={`/tag/${tag.slug}`} class="article-footer-tag">#{tag.label}</a>
									))}
								</span>
							</>
						)}
					</nav>
				)}

				{(olderPost || newerPost) && (
					<nav class="article-pager" aria-label="前後の記事">
						{olderPost && (
							<a href={`/posts/${olderPost.data.id}`} rel="prev" class="article-pager__link article-pager__link--older">
								{showPagerThumbs && <span class="article-pager__thumb"><YohakuImage image={olderCover} alt="" crop sizes="6rem" /></span>}
								<span class="article-pager__text">
									<span class="article-pager__label"><ArrowLeft size={14} strokeWidth={1.7} aria-hidden="true" />前の記事</span>
									<span class="article-pager__title">{olderPost.data.title}</span>
								</span>
							</a>
						)}
						{newerPost && (
							<a href={`/posts/${newerPost.data.id}`} rel="next" class="article-pager__link article-pager__link--newer">
								<span class="article-pager__text">
									<span class="article-pager__label">次の記事<ArrowRight size={14} strokeWidth={1.7} aria-hidden="true" /></span>
									<span class="article-pager__title">{newerPost.data.title}</span>
								</span>
								{showPagerThumbs && <span class="article-pager__thumb"><YohakuImage image={newerCover} alt="" crop sizes="6rem" /></span>}
							</a>
						)}
					</nav>
				)}

				{/* Related posts follow the article in its own column, so a short article is not followed by
				   an empty column beside the long sidebar. Same list cards as the other blog lists. */}
				{otherPostsWithTags.length > 0 && (
					<section class="more-posts" aria-labelledby="more-posts-title">
						<h2 class="more-title" id="more-posts-title">続けて読む</h2>
						<div class="post-list">
							{otherPostsWithTags.map(({ post: p, tags: postTags }) => (
								<PostCard
									title={p.data.title}
									excerpt={getPostExcerpt(p.data.excerpt, p.data.content)}
									featuredImage={otherCovers.get(p.data.id)}
									href={`/posts/${p.data.id}`}
									date={p.data.publishedAt ?? undefined}
									readingTime={getReadingTime(p.data.content)}
									tags={postTags.map((t) => ({ slug: t.slug, label: t.label }))}
									variant="list"
								/>
							))}
						</div>
					</section>
				)}

				<div class="article-comments">
					<Comments collection="posts" contentId={post.data.id} threaded />
					<CommentForm collection="posts" contentId={post.data.id} />
				</div>
			</div>

			{/* Right gutter: profile + compact content discovery */}
			<aside class="article-sidebar">
				<div class="sidebar-sticky">
					<ProfileCard />
					<div class="sidebar-widgets">
						<PostArchiveNav date={post.data.publishedAt} />
						<section class="widget">
							<h3 class="widget__title">検索</h3>
							<div class="widget__content">
								<form method="get" action="/search" class="widget-search">
									<input
										type="search"
										name="q"
										placeholder="記事を検索"
										aria-label="記事を検索"
										class="widget-search__input"
									/>
									<button type="submit" class="widget-search__button" aria-label="検索する">
										<Search size={15} strokeWidth={1.8} aria-hidden="true" />
									</button>
								</form>
							</div>
						</section>
						<SidebarTaxonomies />
					</div>
				</div>
			</aside>
		</div>
	</article>

	<div class="article-float" data-article-float>
		<button type="button" class="article-float__button" popovertarget="article-index" aria-label="目次を開く" hidden data-article-index-button>
			<List size={18} strokeWidth={1.6} aria-hidden="true" />
		</button>
		<button type="button" class="article-float__button" aria-label="ページの先頭へ戻る" data-article-top>
			<ChevronUp size={18} strokeWidth={1.6} aria-hidden="true" />
		</button>
	</div>
	<div id="article-index" popover class="article-index">
		<p class="article-index__title">目次</p>
		<ul class="article-index__list" data-article-index></ul>
	</div>

	<script>
		import "../../client/article-nav";
	</script>
	<script>
		// Build table of contents from h2/h3 headings
		function buildToc() {
			const content = document.querySelector(".article-content");
			const tocContainer = document.getElementById("toc-content");
			if (!content || !tocContainer) return;

			const headings = content.querySelectorAll("h2, h3");
			if (headings.length === 0) {
				return;
			}

			const toc = tocContainer.closest(".toc") as HTMLElement | null;
			const details = toc?.querySelector("details");
			// A long contents list pushes the body below the first screen: start it closed on
			// narrow screens, and on wide screens once it has more than eight entries.
			const wide = window.matchMedia("(min-width: 48rem)").matches;
			if (details && (!wide || headings.length > 8)) details.open = false;
			if (toc) toc.hidden = false;

			const list = document.createElement("ul");
			list.className = "toc-list";

			headings.forEach((heading, index) => {
				// Add ID if missing
				if (!heading.id) {
					heading.id = `heading-${index}`;
				}

				const li = document.createElement("li");
				li.className =
					heading.tagName === "H3" ? "toc-item toc-item--nested" : "toc-item";

				const link = document.createElement("a");
				link.href = `#${heading.id}`;
				link.className = "toc-link";
				link.textContent = heading.textContent;

				li.appendChild(link);
				list.appendChild(li);
			});

			tocContainer.appendChild(list);

			// Highlight current section on scroll
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						const id = entry.target.id;
						const link = tocContainer.querySelector(`a[href="#${id}"]`);
						if (link) {
							if (entry.isIntersecting) {
								tocContainer
									.querySelectorAll(".toc-link")
									.forEach((l) => l.classList.remove("active"));
								link.classList.add("active");
							}
						}
					});
				},
				{ rootMargin: "-80px 0px -80% 0px" }
			);

			headings.forEach((heading) => observer.observe(heading));
		}

		buildToc();
	</script>
</Base>
