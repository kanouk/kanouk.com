---
import {
	getEmDashEntry,
	getEmDashCollection,
	getTermsForEntries,
	getTaxonomyTerms,
	getSeoMeta,
	getSiteSettings,
} from "emdash";
import {
	PortableText,
} from "emdash/ui";
import { Comments, CommentForm } from "emdash/ui/comments";
import { Search } from "lucide-astro";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import PostArchiveNav from "../../components/PostArchiveNav.astro";
import ProfileCard from "../../components/ProfileCard.astro";
import YohakuPortableImage from "../../components/YohakuPortableImage.astro";
import {
	absoluteMediaUrl,
	resolveFirstPortableImageUrl,
	resolvePublicMediaUrl,
} from "../../utils/media-url";
import { getPostExcerpt, getReadingTime } from "../../utils/reading-time";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import { routeSlugCandidates } from "../../utils/route-slug";

const slugCandidates = routeSlugCandidates(Astro.params.slug);
const slug = slugCandidates[0];

if (!slug) {
	return Astro.redirect("/404");
}

let postResult = await getEmDashEntry("posts", slug);
for (const legacySlug of slugCandidates.slice(1)) {
	if (postResult.entry) break;
	postResult = await getEmDashEntry("posts", legacySlug);
}
const { entry: post, cacheHint, isPreview } = postResult;

if (!post) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const canonicalPostPath = `/posts/${post.data.id}`;
if (!isPreview && slug !== post.data.id) {
	return Astro.redirect(canonicalPostPath, 308);
}

// Prefer the cover for social previews, then fall back to the first article image.
// The public page remains list-first and does not invent a visible hero image.
const featuredImageUrl = absoluteMediaUrl(
	resolvePublicMediaUrl(post.data.featured_image)
		?? resolveFirstPortableImageUrl(post.data.content),
	Astro.url.origin,
);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());

// Generate SEO meta from content
const generatedSeo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: canonicalPostPath,
	defaultOgImage: featuredImageUrl,
});
// The stored WordPress canonical can contain a percent-encoded Japanese slug.
// The public contract is the stable EmDash content ID; legacy slugs redirect.
const seo = {
	...generatedSeo,
	canonical: new URL(canonicalPostPath, "https://blog.kanouk.com").toString(),
};

// Bylines are already hydrated by getEmDashEntry
const bylines = post.data.bylines ?? [];

// Get reading time
const readingTime = getReadingTime(post.data.content);

// This post's tags are already hydrated onto the entry by getEmDashEntry —
// no extra query needed.
const tags = post.data.terms?.tag ?? [];
const categories = post.data.terms?.category ?? [];

type SidebarTerm = Awaited<ReturnType<typeof getTaxonomyTerms>>[number];
function flattenTerms(terms: SidebarTerm[]): SidebarTerm[] {
	return terms.flatMap((term) => [term, ...flattenTerms(term.children)]);
}
const [categoryTerms, tagTerms] = await Promise.all([
	getTaxonomyTerms("category", { includeCounts: true }),
	getTaxonomyTerms("tag", { includeCounts: true }),
]);
const sidebarCategories = flattenTerms(categoryTerms).filter((term) => (term.count ?? 0) > 0);
const sidebarTags = flattenTerms(tagTerms)
	.filter((term) => (term.count ?? 0) > 0)
	.slice(0, 20);

// Fetch a few extra recent posts in case the current post is among them.
const { entries: recentPosts } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 4,
});
const otherPosts = recentPosts.filter((p) => p.id !== post.id).slice(0, 3);

// Single batched query for related-posts tags, rather than one
// getEntryTerms() call per related post.
const otherTagsByEntry = await getTermsForEntries(
	"posts",
	otherPosts.map((p) => p.data.id),
	"tag",
);
const otherPostsWithTags = otherPosts.map((p) => ({
	post: p,
	tags: otherTagsByEntry.get(p.data.id) ?? [],
	bylines: p.data.bylines ?? [],
}));

const publishDate =
	post.data.publishedAt?.toLocaleDateString("ja-JP", {
		year: "numeric",
		month: "2-digit",
		day: "2-digit",
		}) ?? null;
const titleSegments = Array.from(
	new Intl.Segmenter("ja", { granularity: "word" }).segment(post.data.title),
	({ segment }) => segment,
);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	content={{ collection: "posts", id: post.data.id, slug: post.id }}
>
	<article class="article">
		<header class="article-lead">
			<h1 class="article-title" {...post.edit.title}>
				{titleSegments.map((segment) => <span class="article-title__segment">{segment}</span>)}
			</h1>
			<div class="article-meta" aria-label="記事情報">
				{
					publishDate && <time datetime={post.data.publishedAt?.toISOString()}>{publishDate}</time>
				}
				{publishDate && categories.length > 0 && <span class="meta-dot" />}
				{
					categories.length > 0 && (
						<span class="article-meta-categories">
							{categories.map((category, index) => (
								<>
									{index > 0 && ", "}
									<a href={`/category/${category.slug}`}>{category.label}</a>
								</>
							))}
						</span>
					)
				}
				{
					bylines.length > 0 && (
						<>
							{(publishDate || categories.length > 0) && <span class="meta-dot" />}
							<span class="article-meta-byline">
								{bylines.map((credit, i) => (
									<>
										{i > 0 && ", "}
										{credit.byline.displayName}
									</>
								))}
							</span>
						</>
					)
				}
				{(publishDate || categories.length > 0 || bylines.length > 0) && <span class="meta-dot" />}
				<span>{readingTime}分</span>
			</div>
			{
				post.data.excerpt && (
					<p class="article-excerpt" {...post.edit.excerpt}>{post.data.excerpt}</p>
				)
			}
		</header>

		{/* Reading column plus a separate discovery rail. */}
		<div class="article-grid">
			{/* Main content */}
			<div class="article-main">
				<nav class="toc article-toc" aria-label="目次" hidden>
					<h2 class="toc-title">目次</h2>
					<div class="toc-content" id="toc-content">
						<!-- Populated by JS -->
					</div>
				</nav>
				<div class="article-content">
					<PortableText
						value={post.data.content}
						components={{ type: { image: YohakuPortableImage } }}
					/>
				</div>

				{
					tags.length > 0 && (
						<nav class="article-tags" aria-label="記事のタグ">
							{tags.map((tag) => (
								<a href={`/tag/${tag.slug}`}>{tag.label}</a>
							))}
						</nav>
					)
				}

				<div class="article-comments">
					<Comments collection="posts" contentId={post.data.id} threaded />
					<CommentForm collection="posts" contentId={post.data.id} />
				</div>
			</div>

			{/* Right gutter: profile + compact content discovery */}
			<aside class="article-sidebar">
				<div class="sidebar-sticky">
					<ProfileCard />
					<div class="sidebar-widgets">
						<PostArchiveNav date={post.data.publishedAt} />
						<section class="widget">
							<h3 class="widget__title">検索</h3>
							<div class="widget__content">
								<form method="get" action="/search" class="widget-search">
									<input
										type="search"
										name="q"
										placeholder="記事を検索"
										aria-label="記事を検索"
										class="widget-search__input"
									/>
									<button type="submit" class="widget-search__button" aria-label="検索する">
										<Search size={15} strokeWidth={1.8} aria-hidden="true" />
									</button>
								</form>
							</div>
						</section>
						{sidebarCategories.length > 0 && (
							<section class="widget">
								<h3 class="widget__title">カテゴリー</h3>
								<div class="widget__content">
									<ul class="widget-categories">
										{sidebarCategories.map((category) => (
											<li>
												<a href={`/category/${category.slug}`} class="widget-categories__link">
													{category.label}
												</a>
												<span class="widget-categories__count">{category.count}</span>
											</li>
										))}
									</ul>
								</div>
							</section>
						)}
						{sidebarTags.length > 0 && (
							<section class="widget">
								<h3 class="widget__title">タグ</h3>
								<div class="widget__content">
									<ul class="widget-tags__cloud">
										{sidebarTags.map((tag) => (
											<li><a href={`/tag/${tag.slug}`} class="widget-tags__link">{tag.label}</a></li>
										))}
									</ul>
								</div>
							</section>
						)}
					</div>
				</div>
			</aside>
		</div>
	</article>

	{
		otherPostsWithTags.length > 0 && (
			<section class="more-posts">
				<div class="more-inner">
					<h2 class="more-title">続けて読む</h2>
					<div class="more-grid">
						{otherPostsWithTags.map(
							({ post: p, tags: postTags, bylines: postBylines }) => (
								<PostCard
									title={p.data.title}
									excerpt={getPostExcerpt(p.data.excerpt, p.data.content)}
									featuredImage={p.data.featured_image}
									href={`/posts/${p.data.id}`}
									date={p.data.publishedAt ?? undefined}
									readingTime={getReadingTime(p.data.content)}
									tags={postTags.map((t) => ({ slug: t.slug, label: t.label }))}
									bylines={postBylines}
								/>
							)
						)}
					</div>
				</div>
			</section>
		)
	}

	<script>
		// Build table of contents from h2/h3 headings
		function buildToc() {
			const content = document.querySelector(".article-content");
			const tocContainer = document.getElementById("toc-content");
			if (!content || !tocContainer) return;

			const headings = content.querySelectorAll("h2, h3");
			if (headings.length === 0) {
				return;
			}

			const toc = tocContainer.closest(".toc") as HTMLElement | null;
			if (toc) toc.hidden = false;

			const list = document.createElement("ul");
			list.className = "toc-list";

			headings.forEach((heading, index) => {
				// Add ID if missing
				if (!heading.id) {
					heading.id = `heading-${index}`;
				}

				const li = document.createElement("li");
				li.className =
					heading.tagName === "H3" ? "toc-item toc-item--nested" : "toc-item";

				const link = document.createElement("a");
				link.href = `#${heading.id}`;
				link.className = "toc-link";
				link.textContent = heading.textContent;

				li.appendChild(link);
				list.appendChild(li);
			});

			tocContainer.appendChild(list);

			// Highlight current section on scroll
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						const id = entry.target.id;
						const link = tocContainer.querySelector(`a[href="#${id}"]`);
						if (link) {
							if (entry.isIntersecting) {
								tocContainer
									.querySelectorAll(".toc-link")
									.forEach((l) => l.classList.remove("active"));
								link.classList.add("active");
							}
						}
					});
				},
				{ rootMargin: "-80px 0px -80% 0px" }
			);

			headings.forEach((heading) => observer.observe(heading));
		}

		buildToc();
	</script>
</Base>
