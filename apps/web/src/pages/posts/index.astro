---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import Base from "../../layouts/Base.astro";
import ArchivePagination from "../../components/ArchivePagination.astro";
import PostCard from "../../components/PostCard.astro";
import { getPostExcerpt, getReadingTime } from "../../utils/reading-time";

const PAGE_SIZE = 24;
const requestedPage = Number.parseInt(Astro.url.searchParams.get("page") ?? "1", 10);
const page = Number.isSafeInteger(requestedPage) && requestedPage > 0 ? requestedPage : 1;

// Sort in the database rather than in JS — lets the DB use its index on
// published_at and avoids a full-table scan on the client.
const { entries: posts, hasMore = false, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: PAGE_SIZE,
	offset: (page - 1) * PAGE_SIZE,
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Resolve list taxonomies in two batched queries instead of one round-trip per
// post. The historical card order is category, then tag.
const [categoriesByEntry, tagsByEntry] = await Promise.all([
	getTermsForEntries("posts", posts.map((p) => p.data.id), "category"),
	getTermsForEntries("posts", posts.map((p) => p.data.id), "tag"),
]);

const postsWithTags = posts.map((post) => ({
	post,
	categories: categoriesByEntry.get(post.data.id) ?? [],
	tags: tagsByEntry.get(post.data.id) ?? [],
	excerpt: getPostExcerpt(post.data.excerpt, post.data.content, 180),
}));

---

<Base title="すべての記事" description="公開している記事の一覧">
	<div class="posts-page">
		<header class="page-header">
			<h1 class="page-title">すべての記事</h1>
			<p class="page-description">
				{page > 1 ? `${page}ページ目・` : ""}{posts.length.toLocaleString("ja-JP")}件を表示
			</p>
		</header>

		{
			posts.length === 0 ? (
				<p class="empty">公開中の記事はまだありません。</p>
			) : (
				<div class="post-list">
					{postsWithTags.map(({ post, categories, tags, excerpt }, index) => (
						<PostCard
							variant="list"
							title={post.data.title}
							excerpt={excerpt}
							featuredImage={post.data.featured_image}
							href={`/posts/${post.data.id}`}
							date={post.data.publishedAt ?? undefined}
							readingTime={getReadingTime(post.data.content)}
							categories={categories.slice(0, 1).map((category) => ({ slug: category.slug, label: category.label }))}
							tags={tags.map((t) => ({ slug: t.slug, label: t.label }))}
							priority={page === 1 && index < 2}
						/>
					))}
				</div>
			)
		}
		<ArchivePagination page={page} hasMore={hasMore} basePath="/posts" />
	</div>
</Base>
