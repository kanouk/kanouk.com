---
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import YohakuPortableImage from "../../components/YohakuPortableImage.astro";
import { routeSlugCandidates } from "../../utils/route-slug";

const slugCandidates = routeSlugCandidates(Astro.params.slug);
const slug = slugCandidates[0];

if (!slug) {
	return Astro.redirect("/404");
}

let pageResult = await getEmDashEntry("pages", slug);
for (const legacySlug of slugCandidates.slice(1)) {
	if (pageResult.entry) break;
	pageResult = await getEmDashEntry("pages", legacySlug);
}
const { entry: page, cacheHint } = pageResult;

if (!page) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base
	title={page.data.title}
	content={{ collection: "pages", id: page.data.id, slug: page.id }}
>
	<article class="page-article">
		<header class="page-header">
			<h1 class="page-title" {...page.edit.title}>{page.data.title}</h1>
		</header>

		<div class="page-content">
			<PortableText
				value={page.data.content}
				components={{ type: { image: YohakuPortableImage } }}
			/>
		</div>
	</article>
</Base>
