---
import { getEmDashCollection, getEmDashEntry } from "emdash";
import {
	ArrowLeft,
	ArrowRight,
	Camera,
	Download,
	ExternalLink,
	Expand,
	Info,
	MapPin,
	Pause,
	Play,
	Share2,
	Tags,
	X,
} from "lucide-astro";
import YohakuImage from "../../components/YohakuImage.astro";
import Photos from "../../layouts/Photos.astro";
import { resolvePublicMediaUrl } from "../../utils/media-url";
import { looksLikeSourceFilename, publicPhotoTitle } from "../../utils/photo-display.mjs";
import { getPhotoNavigation } from "../../utils/photo-navigation";
import { photoPath } from "../../utils/photo-url.mjs";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

const { entry: photo, cacheHint: photoCache } = await getEmDashEntry("photos", slug);
if (!photo) return Astro.redirect("/404");
if (Astro.cache?.enabled) Astro.cache.set(photoCache);

const [albumResult, navigation] = await Promise.all([
	getEmDashCollection("albums", {
		status: "published",
		where: { id: photo.data.album },
		limit: 1,
	}),
	getPhotoNavigation(photo.data.album, photo.data.id),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(albumResult.cacheHint);
	Astro.cache.set({ tags: ["albums", "photos"] });
}
const album = albumResult.entries[0];
const previousUrl = navigation?.previousId ? photoPath(navigation.previousId) : undefined;
const nextUrl = navigation?.nextId ? photoPath(navigation.nextId) : undefined;
const slideshowNextUrl = nextUrl || (
	navigation?.firstId && navigation.firstId !== photo.data.id
		? photoPath(navigation.firstId)
		: undefined
);
const downloadUrl = album?.data.allow_downloads ? `/media/${photo.id}` : undefined;
const videoStorageKey = photo.data.video?.meta?.storageKey;
const posterSource = resolvePublicMediaUrl(photo.data.image);
const videoSource =
	photo.data.kind === "video"
		? photo.data.video?.src ||
			photo.data.video?.url ||
			(typeof videoStorageKey === "string"
				? `/_emdash/api/media/file/${encodeURIComponent(videoStorageKey)}`
				: undefined)
		: undefined;

const capturedDate = photo.data.captured_at?.match(/^(\d{4})-(\d{2})-(\d{2})/);
const formattedDate = capturedDate
	? `${Number(capturedDate[1])}年${Number(capturedDate[2])}月${Number(capturedDate[3])}日`
	: undefined;

const latitude = photo.data.latitude;
const longitude = photo.data.longitude;
const hasLocation =
	typeof latitude === "number" &&
	Number.isFinite(latitude) &&
	latitude >= -90 &&
	latitude <= 90 &&
	typeof longitude === "number" &&
	Number.isFinite(longitude) &&
	longitude >= -180 &&
	longitude <= 180;
const mapEmbedUrl = hasLocation
	? (() => {
			const latitudeSpan = 0.008;
			const longitudeSpan = 0.012;
			const params = new URLSearchParams({
				bbox: [
					longitude - longitudeSpan,
					latitude - latitudeSpan,
					longitude + longitudeSpan,
					latitude + latitudeSpan,
				].join(","),
				layer: "mapnik",
				marker: `${latitude},${longitude}`,
			});
			return `https://www.openstreetmap.org/export/embed.html?${params}`;
		})()
	: undefined;
const mapLinkUrl = hasLocation
	? `https://www.openstreetmap.org/?mlat=${latitude}&mlon=${longitude}#map=15/${latitude}/${longitude}`
	: undefined;

const sourceMetadata = photo.data.source_metadata;
const exif = sourceMetadata && typeof sourceMetadata === "object"
	? (sourceMetadata as Record<string, unknown>).exif
	: undefined;
const exifData = exif && typeof exif === "object" ? exif as Record<string, unknown> : {};
const sourceKeywords = sourceMetadata && typeof sourceMetadata === "object"
	? (sourceMetadata as Record<string, unknown>).keywords
	: undefined;
const keywords = Array.isArray(sourceKeywords)
	? sourceKeywords.filter(
		(keyword): keyword is string =>
			typeof keyword === "string" && Boolean(keyword.trim()),
	)
	: [];
const textValue = (value: unknown) =>
	typeof value === "string" && value.trim() ? value.trim() : undefined;
const numberValue = (value: unknown) =>
	typeof value === "number" && Number.isFinite(value) ? value : undefined;
const make = textValue(exifData.Make);
const model = textValue(exifData.Model);
const camera = make && model
	? (model.toLowerCase().startsWith(make.toLowerCase()) ? model : `${make} ${model}`)
	: model || make;
const lens = textValue(exifData.LensModel);
const fNumber = numberValue(exifData.FNumber);
const exposureTime = numberValue(exifData.ExposureTime);
const iso = numberValue(exifData.ISO);
const focalLength = numberValue(exifData.FocalLength);
const exposureCompensation = numberValue(exifData.ExposureCompensation);
const displayTitle = publicPhotoTitle({
	title: photo.data.title,
	sourceSystem: photo.data.source_system,
	sourceMetadata,
});
const displayCaption = textValue(photo.data.caption);
const pageTitle = displayTitle || (album?.data.title ? `${album.data.title}の写真` : "写真");
const storedAlt = textValue(photo.data.alt) || textValue(photo.data.image?.alt);
const publicAlt = storedAlt && !looksLikeSourceFilename(storedAlt)
	? storedAlt
	: displayTitle || displayCaption || (album?.data.title ? `${album.data.title}の写真` : "写真");
const exifDetails = [
	{ label: "カメラ", value: camera },
	{ label: "レンズ", value: lens },
	{ label: "絞り", value: fNumber ? `f/${fNumber}` : undefined },
	{
		label: "シャッター速度",
		value: exposureTime
			? (exposureTime < 1 ? `1/${Math.round(1 / exposureTime)}秒` : `${exposureTime}秒`)
			: undefined,
	},
	{ label: "ISO", value: iso ? String(iso) : undefined },
	{ label: "焦点距離", value: focalLength ? `${focalLength} mm` : undefined },
	{
		label: "露出補正",
		value: exposureCompensation !== undefined
			? `${exposureCompensation > 0 ? "+" : ""}${exposureCompensation} EV`
			: undefined,
	},
].filter((item): item is { label: string; value: string } => Boolean(item.value));
---

<Photos
	title={pageTitle}
	description={displayCaption}
	image={posterSource}
	pageType={photo.data.kind === "video" ? "video" : "image"}
	content={{ collection: "photos", id: photo.data.id, slug: photo.id }}
>
	<article
		class="photo-page"
		data-previous-url={previousUrl}
		data-next-url={nextUrl}
		data-slideshow-next-url={slideshowNextUrl}
	>
		<a class="back" href={album ? `/albums/${album.id}` : "/albums"} data-astro-prefetch="hover">
			<ArrowLeft size={15} strokeWidth={1.75} aria-hidden="true" />
			<span>{album?.data.title || "すべてのアルバム"}</span>
		</a>
		{!displayTitle && <h1 class="sr-only">{pageTitle}</h1>}
		<figure>
			<div class="media" {...photo.edit.image}>
				<div class="photo-action-rail" role="group" aria-label="写真の操作">
					<button type="button" data-photo-fullscreen aria-label="写真を全画面で表示" title="全画面">
						<Expand size={18} strokeWidth={1.65} aria-hidden="true" />
						<span class="sr-only">全画面</span>
					</button>
					{slideshowNextUrl && (
						<button type="button" data-photo-slideshow aria-pressed="false" aria-label="スライドショーを開始" title="自動再生">
							<Play class="photo-tool-play" size={18} strokeWidth={1.65} aria-hidden="true" />
							<Pause class="photo-tool-pause" size={18} strokeWidth={1.65} aria-hidden="true" />
							<span class="sr-only" data-photo-slideshow-label>自動再生</span>
						</button>
					)}
					<button
						type="button"
						data-photo-info
						aria-expanded="false"
						aria-controls="photo-info-panel"
						aria-label="写真情報を表示"
						title="写真情報"
					>
						<Info size={18} strokeWidth={1.65} aria-hidden="true" />
						<span class="sr-only">写真情報</span>
					</button>
					<button type="button" data-photo-share aria-label="写真を共有" title="共有">
						<Share2 size={18} strokeWidth={1.65} aria-hidden="true" />
						<span class="sr-only">共有</span>
					</button>
					{downloadUrl && (
						<a href={downloadUrl} download aria-label="写真をダウンロード" title="保存">
							<Download size={18} strokeWidth={1.65} aria-hidden="true" />
							<span class="sr-only">保存</span>
						</a>
					)}
					<span class="sr-only photo-tool-status" role="status" aria-live="polite" />
				</div>
				<aside id="photo-info-panel" class="photo-info-panel" data-photo-info-panel aria-label="写真情報" hidden>
					<header class="photo-info-panel__header">
						<div>
							{displayTitle && <p class="photo-info-panel__title">{displayTitle}</p>}
							{displayCaption && <p class="photo-info-panel__caption">{displayCaption}</p>}
						</div>
						<button type="button" data-photo-info-close aria-label="写真情報を閉じる">
							<X size={20} strokeWidth={1.6} aria-hidden="true" />
						</button>
					</header>
					<div class="photo-info-panel__body">
						<div class="photo-info-context">
							<span>{navigation?.position ?? 1} / {navigation?.total ?? 1}</span>
							{formattedDate && <time>{formattedDate}</time>}
						</div>
						{exifDetails.length > 0 && (
							<section class="photo-info-section photo-info-exif" aria-labelledby="exif-title">
								<h2 id="exif-title">
									<Camera size={16} strokeWidth={1.65} aria-hidden="true" />
									<span>撮影情報</span>
								</h2>
								<dl>
									{exifDetails.map((item) => (
										<div>
											<dt>{item.label}</dt>
											<dd>{item.value}</dd>
										</div>
									))}
								</dl>
							</section>
						)}
						{keywords.length > 0 && (
							<section class="photo-info-section photo-info-keywords" aria-labelledby="keyword-title">
								<h2 id="keyword-title">
									<Tags size={16} strokeWidth={1.65} aria-hidden="true" />
									<span>キーワード</span>
								</h2>
								<ul>
									{keywords.map((keyword) => <li>{keyword}</li>)}
								</ul>
							</section>
						)}
						{mapEmbedUrl && mapLinkUrl && (
							<section class="photo-info-section photo-info-location" aria-labelledby="location-title">
								<div class="photo-info-location__heading">
									<h2 id="location-title">
										<MapPin size={16} strokeWidth={1.65} aria-hidden="true" />
										<span>撮影場所</span>
									</h2>
									<a href={mapLinkUrl} target="_blank" rel="noopener noreferrer" aria-label="OpenStreetMapで撮影場所を見る">
										<ExternalLink size={15} strokeWidth={1.65} aria-hidden="true" />
									</a>
								</div>
								<iframe
									data-photo-map
									data-src={mapEmbedUrl}
									title={`${displayTitle || album?.data.title || "写真"}の撮影場所`}
									loading="lazy"
									referrerpolicy="no-referrer"
								/>
							</section>
						)}
					</div>
				</aside>
				{previousUrl && (
					<a class="media-navigation media-navigation--previous" href={previousUrl} aria-label="前の写真" data-astro-prefetch="hover">
						<ArrowLeft size={22} strokeWidth={1.6} aria-hidden="true" />
					</a>
				)}
				<div class="photo-media-frame">
					{
						videoSource ? (
							<video controls playsinline preload="metadata" poster={posterSource}>
								<source src={videoSource} type={photo.data.video?.mimeType || "video/mp4"} />
								動画を再生できないブラウザです。
							</video>
						) : (
							<YohakuImage image={photo.data.image} alt={publicAlt} preview priority sizes="100vw" />
						)
					}
					{(displayTitle || displayCaption) && (
						<div class="photo-overlay">
							<div class="photo-overlay__copy">
								{displayTitle && <h1 id="photo-title" {...photo.edit.title}>{displayTitle}</h1>}
								{displayCaption && <p {...photo.edit.caption}>{displayCaption}</p>}
							</div>
						</div>
					)}
				</div>
				{nextUrl && (
					<a class="media-navigation media-navigation--next" href={nextUrl} aria-label="次の写真" data-astro-prefetch="hover">
						<ArrowRight size={22} strokeWidth={1.6} aria-hidden="true" />
					</a>
				)}
			</div>
		</figure>
	</article>
</Photos>

<script>
	const page = document.querySelector<HTMLElement>(".photo-page");
	const media = page?.querySelector<HTMLElement>(".media");
	const previousUrl = page?.dataset.previousUrl;
	const nextUrl = page?.dataset.nextUrl;
	const slideshowNextUrl = page?.dataset.slideshowNextUrl;
	const status = page?.querySelector<HTMLElement>(".photo-tool-status");
	const slideshowButton = page?.querySelector<HTMLButtonElement>("[data-photo-slideshow]");
	const slideshowLabel = slideshowButton?.querySelector<HTMLElement>("[data-photo-slideshow-label]");
	const infoButton = page?.querySelector<HTMLButtonElement>("[data-photo-info]");
	const infoPanel = page?.querySelector<HTMLElement>("[data-photo-info-panel]");
	const infoCloseButton = page?.querySelector<HTMLButtonElement>("[data-photo-info-close]");
	const infoMap = page?.querySelector<HTMLIFrameElement>("[data-photo-map]");
	let slideshowTimer: number | undefined;

	const announce = (message: string) => {
		if (status) status.textContent = message;
	};
	const navigate = (url?: string) => {
		if (url) window.location.assign(url);
	};
	const slideshowUrl = (url: string) => {
		const destination = new URL(url, window.location.href);
		destination.searchParams.set("slideshow", "1");
		return destination.toString();
	};
	const stopSlideshow = () => {
		if (slideshowTimer) window.clearTimeout(slideshowTimer);
		slideshowTimer = undefined;
		slideshowButton?.setAttribute("aria-pressed", "false");
		slideshowButton?.setAttribute("aria-label", "スライドショーを開始");
		if (slideshowLabel) slideshowLabel.textContent = "自動再生";
		const current = new URL(window.location.href);
		current.searchParams.delete("slideshow");
		window.history.replaceState(null, "", current);
		announce("スライドショーを停止しました");
	};
	const startSlideshow = () => {
		if (!slideshowNextUrl) return;
		slideshowButton?.setAttribute("aria-pressed", "true");
		slideshowButton?.setAttribute("aria-label", "スライドショーを停止");
		if (slideshowLabel) slideshowLabel.textContent = "停止";
		announce("6秒ごとに次の写真へ進みます");
		slideshowTimer = window.setTimeout(() => navigate(slideshowUrl(slideshowNextUrl)), 6000);
	};
	const openInfoPanel = () => {
		if (!infoButton || !infoPanel) return;
		infoPanel.hidden = false;
		infoButton.setAttribute("aria-expanded", "true");
		infoButton.setAttribute("aria-label", "写真情報を閉じる");
		if (infoMap?.dataset.src && !infoMap.getAttribute("src")) {
			infoMap.setAttribute("src", infoMap.dataset.src);
		}
	};
	const closeInfoPanel = (restoreFocus = true) => {
		if (!infoButton || !infoPanel) return;
		infoPanel.hidden = true;
		infoButton.setAttribute("aria-expanded", "false");
		infoButton.setAttribute("aria-label", "写真情報を表示");
		if (restoreFocus) infoButton.focus();
	};

	page?.querySelector<HTMLButtonElement>("[data-photo-fullscreen]")?.addEventListener("click", async () => {
		if (!media) return;
		try {
			if (document.fullscreenElement) await document.exitFullscreen();
			else await media.requestFullscreen();
		} catch {
			announce("このブラウザでは全画面表示を開始できませんでした");
		}
	});
	page?.querySelector<HTMLButtonElement>("[data-photo-share]")?.addEventListener("click", async () => {
		try {
			if (navigator.share) await navigator.share({ title: document.title, url: window.location.href });
			else {
				await navigator.clipboard.writeText(window.location.href);
				announce("URLをコピーしました");
			}
		} catch (error) {
			if ((error as DOMException).name !== "AbortError") announce("共有を開始できませんでした");
		}
	});
	slideshowButton?.addEventListener("click", () => {
		if (slideshowTimer) stopSlideshow();
		else startSlideshow();
	});
	infoButton?.addEventListener("click", () => {
		if (infoPanel?.hidden) openInfoPanel();
		else closeInfoPanel(false);
	});
	infoCloseButton?.addEventListener("click", () => closeInfoPanel());

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && infoPanel && !infoPanel.hidden) {
			closeInfoPanel();
			return;
		}
		if (event.key === "Escape" && slideshowTimer) {
			stopSlideshow();
			return;
		}
		const target = event.target as HTMLElement | null;
		if (target?.matches("input, textarea, select, button, a, [contenteditable=true]")) return;
		if (event.key === "ArrowLeft" && previousUrl) navigate(previousUrl);
		if (event.key === "ArrowRight" && nextUrl) navigate(nextUrl);
	});

	let touchStartX: number | undefined;
	let touchStartY: number | undefined;
	media?.addEventListener("pointerdown", (event) => {
		if ((event.target as HTMLElement).closest("video")) return;
		touchStartX = event.clientX;
		touchStartY = event.clientY;
	});
	media?.addEventListener("pointerup", (event) => {
		if (touchStartX === undefined || touchStartY === undefined) return;
		const deltaX = event.clientX - touchStartX;
		const deltaY = event.clientY - touchStartY;
		touchStartX = undefined;
		touchStartY = undefined;
		if (Math.abs(deltaX) < 56 || Math.abs(deltaX) <= Math.abs(deltaY) * 1.25) return;
		navigate(deltaX > 0 ? previousUrl : nextUrl);
	});

	if (new URL(window.location.href).searchParams.get("slideshow") === "1") startSlideshow();
</script>
