---
import { Quote } from "lucide-astro";
import { PortableText } from "emdash/ui";

const { content, body, source } = Astro.props.node;
---

<figure class="yohaku-quote">
	<Quote class="yohaku-quote__mark" size={18} stroke-width={1.75} aria-hidden="true" />
	<blockquote class="yohaku-quote__body">
		{Array.isArray(content) ? <PortableText value={content} /> : body && <p>{body}</p>}
	</blockquote>
	{source && <figcaption>— {source}</figcaption>}
</figure>

<style>
	/* The mark sits in its own column beside the first line, so a one-line quote stays one line tall. */
	.yohaku-quote {
		display: grid;
		grid-template-columns: 1.125rem minmax(0, 1fr);
		column-gap: 0.8rem;
		margin: 2em 0;
		padding: 0.95rem 1.25rem 0.95rem 1rem;
		border-radius: var(--radius, 0.18rem);
		background: var(--paper-muted, var(--color-bg-subtle));
		color: var(--ink-soft, var(--color-text-secondary));
	}

	.yohaku-quote__mark {
		grid-column: 1;
		width: 1.125rem;
		height: 1.125rem;
		/* Centre the 18px mark on the first line box. */
		margin-top: calc((var(--line-body, 1.9) * 1em - 1.125rem) / 2);
		color: var(--accent, var(--color-brand));
		opacity: 0.7;
	}

	.yohaku-quote__body {
		grid-column: 2;
		margin: 0;
		padding: 0;
		border: 0;
		background: none;
		color: inherit;
		font: inherit;
		line-height: var(--line-body, 1.9);
	}

	.yohaku-quote__body::before {
		content: none;
	}

	.yohaku-quote :global(p),
	.yohaku-quote :global(ul),
	.yohaku-quote :global(ol) {
		margin-block: 0.75em;
	}

	.yohaku-quote__body :global(:first-child) {
		margin-top: 0;
	}

	.yohaku-quote__body :global(:last-child) {
		margin-bottom: 0;
	}

	figcaption {
		grid-column: 2;
		margin-top: 0.5rem;
		color: var(--ink-muted, var(--color-muted));
		font-size: 0.78rem;
		letter-spacing: 0.03em;
	}
</style>
