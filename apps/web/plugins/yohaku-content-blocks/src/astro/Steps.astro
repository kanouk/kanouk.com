---
import { PortableText } from "emdash/ui";
const items = Array.isArray(Astro.props.node.items) ? Astro.props.node.items : [];
---
<ol class="yohaku-steps">
	{items.map((item, index) => <li><span>{index + 1}</span><div><h3>{item.title}</h3>{Array.isArray(item.content) && <PortableText value={item.content} />}</div></li>)}
</ol>
<style>
	.yohaku-steps { list-style: none; margin: 2.5rem 0; padding: 0; border-top: 1px solid var(--color-border); }
	li { display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: 1rem; padding: 1.35rem 0; border-bottom: 1px solid var(--color-border); }
	span { color: var(--color-brand); font: 600 0.75rem/1.8 var(--font-mono), monospace; }
	h3 { margin: 0 0 0.65rem; font-size: 1.05rem; }
	div :global(p:first-of-type) { margin-top: 0; }
	div :global(p:last-child) { margin-bottom: 0; }
</style>
