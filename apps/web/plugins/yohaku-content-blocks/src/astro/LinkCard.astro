---
import { env } from "virtual:emdash/env";
import { resolveInternalLinkPreview } from "../../../../src/utils/article-social";
import {
	createD1LinkPreviewCacheReader,
	getCachedLinkPreviewIncludingStale,
	isOwnLinkPreviewHost,
	safeLinkPreviewImageUrl,
	type LinkPreviewAutoSnapshot,
} from "../link-preview";

const node = Astro.props.node;
const { id, url, title, caption } = node;
let { description, imageUrl } = node;
const candidate = typeof (id || url) === "string" ? String(id || url).trim() : "";
let href = "";
let host = "";
let isExternal = false;
let absoluteTarget = "";
let ownTarget = false;
try {
	const parsed = new URL(candidate, Astro.url);
	if (["http:", "https:"].includes(parsed.protocol)) {
		href = candidate.startsWith("/") ? `${parsed.pathname}${parsed.search}${parsed.hash}` : parsed.href;
		parsed.hash = "";
		absoluteTarget = parsed.href;
		host = parsed.hostname.replace(/^www\./, "");
		isExternal = parsed.origin !== Astro.url.origin;
		ownTarget = isOwnLinkPreviewHost(parsed.hostname);
	}
} catch {}
const savedText = (value: unknown): string => typeof value === "string" ? value.trim() : "";
const savedAuto = node.linkPreviewAuto as Partial<LinkPreviewAutoSnapshot> | undefined;
const autoSnapshot = savedAuto?.version === 1 &&
	["url", "title", "description", "imageUrl", "fetchedAt"].every((key) => typeof savedAuto[key as keyof LinkPreviewAutoSnapshot] === "string") &&
	savedAuto.url === absoluteTarget
		? savedAuto as LinkPreviewAutoSnapshot
		: null;
let metadata: { title: string; description: string; imageUrl: string } | null = null;
if (href && env?.DB) {
	try {
		metadata = await resolveInternalLinkPreview(env.DB, absoluteTarget, { origin: Astro.url.origin });
		if (!metadata && !ownTarget) {
			metadata = await getCachedLinkPreviewIncludingStale(absoluteTarget, createD1LinkPreviewCacheReader(env.DB));
		}
		if (Astro.cache?.enabled) Astro.cache.set({ tags: ["posts", "pages", "photos", "albums", "settings"] });
	} catch {
		// A cache miss or unavailable metadata never removes the original link.
	}
}
const currentAuto = metadata ?? (!ownTarget ? autoSnapshot : null);
const manualTitle = savedText(title);
const manualDescription = savedText(description);
const manualImage = savedText(imageUrl);
description = manualDescription || currentAuto?.description || "";
imageUrl = manualImage || safeLinkPreviewImageUrl(currentAuto?.imageUrl || "", ownTarget) || "";
try {
	if (imageUrl) {
		const image = new URL(imageUrl, Astro.url);
		if (!['http:', 'https:'].includes(image.protocol) || image.username || image.password) imageUrl = "";
	}
} catch { imageUrl = ""; }
const meaningfulTitle = manualTitle || currentAuto?.title || href;
const eyebrow = typeof caption === "string" && caption.trim()
	? caption.trim()
	: isExternal
		? host
		: "あわせて読みたい";
---

{href && (
	<a
		class:list={["yohaku-link-card", !imageUrl && "has-no-image"]}
		href={href}
		target={isExternal ? "_blank" : undefined}
		rel={isExternal ? "noopener noreferrer" : undefined}
		data-yohaku-link-preview={node._key ? "true" : undefined}
		data-collection={Astro.url.pathname.match(/^\/(posts|pages)\/[^/]+\/?$/)?.[1]}
		data-entry-id={(() => {
			const value = Astro.url.pathname.match(/^\/(?:posts|pages)\/([^/]+)\/?$/)?.[1];
			if (!value) return undefined;
			try { return decodeURIComponent(value); } catch { return undefined; }
		})()}
		data-block-key={typeof node._key === "string" ? node._key : undefined}
		data-manual-title={manualTitle ? "true" : "false"}
		data-manual-description={manualDescription ? "true" : "false"}
		data-manual-image={manualImage ? "true" : "false"}
		data-fallback-title={href}
	>
		<span class="yohaku-link-card__thumb" aria-hidden="true" hidden={!imageUrl}>
			<img src={imageUrl || undefined} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
		</span>
		<span class="yohaku-link-card__body">
			<span class="yohaku-link-card__eyebrow">{eyebrow}</span>
			<strong data-link-preview-title>{meaningfulTitle}</strong>
			<small data-link-preview-description hidden={!description}>{description}</small>
		</span>
		<em aria-hidden="true">{host} ↗</em>
	</a>
)}

<script>
	import "../link-preview-client";
</script>

<style>
	.yohaku-link-card {
		display: grid;
		grid-template-columns: 9.25rem minmax(0, 1fr) auto;
		gap: 1rem;
		align-items: center;
		margin: 2rem 0;
		padding: 0.85rem;
		border: 1px solid var(--color-border);
		background: var(--color-bg);
		color: inherit;
		text-decoration: none;
		transition: border-color 150ms ease, transform 150ms ease;
	}

	.yohaku-link-card:hover {
		border-color: var(--color-text-secondary);
		transform: translateY(-1px);
	}

	.yohaku-link-card.has-no-image { grid-template-columns: minmax(0, 1fr) auto; }
	.yohaku-link-card__thumb[hidden], small[hidden] { display: none; }
	.yohaku-link-card__thumb { display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--color-bg-subtle); }
	.yohaku-link-card__thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }
	.yohaku-link-card__body { min-width: 0; }
	.yohaku-link-card__eyebrow {
		display: block;
		margin-bottom: 0.35rem;
		color: var(--color-muted);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.06em;
	}
	strong, small { display: block; }
	strong { font-family: var(--font-heading); font-size: 1rem; line-height: 1.45; overflow-wrap: anywhere; }
	small { display: -webkit-box; margin-top: 0.35rem; overflow: hidden; color: var(--color-text-secondary); font-size: 0.78rem; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
	em { align-self: end; color: var(--color-muted); font: 500 0.65rem/1 var(--font-mono), monospace; font-style: normal; white-space: nowrap; }

	@media (max-width: 34rem) {
		.yohaku-link-card,
		.yohaku-link-card.has-no-image { grid-template-columns: 5.75rem minmax(0, 1fr); padding: 0.7rem; }
		.yohaku-link-card.has-no-image { grid-template-columns: minmax(0, 1fr); }
		em { display: none; }
	}
</style>
