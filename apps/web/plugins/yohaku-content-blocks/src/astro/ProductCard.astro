---
const { id, url, title, imageUrl, price, label = "商品を見る", links = [] } = Astro.props.node;
const href = id || url;
const actions = Array.isArray(links) && links.length > 0
	? links.filter((link) => link && typeof link.url === "string" && link.url)
	: href
		? [{ label, url: href }]
		: [];
const displayTitle = typeof title === "string" && title.trim() && title !== "商品情報"
	? title.trim()
	: null;
const hasContent = Boolean(displayTitle || imageUrl || actions.length > 0);
const numericPrice = typeof price === "number" ? price : Number(String(price || "").replace(/[^\d.]/g, ""));
const displayPrice = Number.isFinite(numericPrice) && numericPrice > 0
	? new Intl.NumberFormat("ja-JP", { style: "currency", currency: "JPY", maximumFractionDigits: 0 }).format(numericPrice)
	: null;
---
{hasContent && (
	<aside class="yohaku-product-card">
		{imageUrl && <img src={imageUrl} alt="" loading="lazy" />}
		<div>
			<p class="product-title">{displayTitle || "商品情報"}</p>
			{displayPrice && <p class="product-price">取得時価格 {displayPrice}</p>}
			{actions.length > 0 && (
				<ul aria-label="購入先">
					{actions.map((action) => (
						<li><a href={action.url} rel="nofollow sponsored">{action.label || label} ↗</a></li>
					))}
				</ul>
			)}
		</div>
	</aside>
)}
<style>
	.yohaku-product-card { display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: 1.25rem; align-items: start; margin: 2.5rem 0; padding: 1.25rem 0; border-block: 1px solid var(--color-border); }
	/* No backing colour: a white box behind the cover shows as bars on the page's paper tone. */
	img { width: 7rem; height: 7rem; object-fit: contain; object-position: top; }
	.product-title { margin: 0 0 0.35rem; font-family: var(--font-heading); font-weight: 600; }
	.product-price { margin: 0 0 0.25rem; color: var(--color-text-secondary); font-size: 0.76rem; font-variant-numeric: tabular-nums; }
	ul { display: flex; flex-wrap: wrap; align-items: center; gap: 0 1.25rem; margin: 0; padding: 0; list-style: none; }
	/* Article lists space every item after the first; here the items sit side by side. */
	.yohaku-product-card li { margin: 0; }
	a { display: inline-flex; align-items: center; min-height: 2.75rem; font-size: 0.875rem; }
	@media (max-width: 30rem) { .yohaku-product-card { grid-template-columns: 5rem minmax(0, 1fr); } img { width: 5rem; height: 5rem; } }
</style>
