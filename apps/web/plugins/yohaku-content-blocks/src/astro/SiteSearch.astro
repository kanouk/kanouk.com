---
const { label = "ブログ内を検索", placeholder = "検索語を入力" } = Astro.props.node;
---
<form class="yohaku-site-search" method="get" action="/search" role="search">
	<label>
		<span>{label}</span>
		<input type="search" name="q" placeholder={placeholder} required />
	</label>
	<button type="submit">検索</button>
</form>
<style>
	.yohaku-site-search { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .75rem; align-items: end; margin: 2.5rem 0; padding-block: 1.25rem; border-block: 1px solid var(--color-border); }
	label span { display: block; margin-bottom: .5rem; color: var(--color-text-secondary); font-size: .78rem; }
	input, button { min-height: 44px; border: 1px solid var(--color-border); border-radius: 0; font: inherit; }
	input { width: 100%; padding: .65rem .75rem; background: var(--color-bg); color: var(--color-text); }
	button { padding: .65rem 1rem; border-color: var(--color-text); background: var(--color-text); color: var(--color-bg); cursor: pointer; }
	@media (max-width: 30rem) { .yohaku-site-search { grid-template-columns: 1fr; } }
</style>
