---
const { images = [], columns = 3 } = Astro.props.node;
const safeImages = (Array.isArray(images) ? images : []).flatMap((image) => {
	const src = image?.asset?.url || image?.src;
	if (typeof src !== "string" || !src.trim()) return [];
	const href = image.link || src;
	return [{
		...image,
		src: src.trim(),
		href: typeof href === "string" && href.trim() ? href.trim() : src.trim(),
	}];
});
const columnCount = Math.max(1, Math.min(Number(columns) || 3, 4, safeImages.length || 1));
---

{safeImages.length > 0 && (
	<div
		class:list={["yohaku-gallery", safeImages.length === 1 && "is-single"]}
		style={`--gallery-columns: ${columnCount}`}
		aria-label="記事内の写真"
	>
		{safeImages.map((image) => (
			<figure>
				<a href={image.href} target="_blank" rel="noopener" aria-label="画像を原寸で開く">
					<img
						src={image.src}
						alt={image.alt || ""}
						width={image.width}
						height={image.height}
						loading="lazy"
						decoding="async"
					/>
				</a>
				{image.caption && <figcaption>{image.caption}</figcaption>}
			</figure>
		))}
	</div>
)}

<style>
	.yohaku-gallery {
		display: grid;
		grid-template-columns: repeat(var(--gallery-columns), minmax(0, 1fr));
		gap: clamp(0.55rem, 1.6vw, 1rem);
		margin: clamp(2rem, 5vw, 3rem) 0;
	}

	figure { margin: 0; min-width: 0; }
	a { display: block; color: inherit; }
	img {
		display: block;
		width: 100%;
		height: 100%;
		max-height: 78vh;
		border: 1px solid var(--color-border-subtle);
		background: var(--color-bg-subtle);
		object-fit: cover;
	}

	.is-single img { height: auto; object-fit: contain; }
	figcaption {
		margin-top: 0.45rem;
		color: var(--color-muted);
		font-size: 0.76rem;
		line-height: 1.6;
	}

	@media (max-width: 38rem) {
		.yohaku-gallery:not(.is-single) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
</style>
