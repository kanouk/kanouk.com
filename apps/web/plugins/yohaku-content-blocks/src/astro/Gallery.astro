---
import YohakuImage from "../../../../src/components/YohakuImage.astro";

const { images = [], columns = 3, _yohakuPriority = false } = Astro.props.node;
const safeImages = (Array.isArray(images) ? images : []).flatMap((image) => {
	const candidate = image?.asset?.url || image?.src;
	if (typeof candidate !== "string" || !candidate.trim()) return [];
	const rawSrc = candidate.trim();
	const bareStorageKey = /^[A-Za-z0-9._-]+$/.test(rawSrc) ? rawSrc : undefined;
	let storageKey = bareStorageKey;
	try {
		const parsed = new URL(rawSrc, Astro.url);
		const matchedKey = parsed.pathname.match(/^\/_emdash\/api\/media\/file\/([^/?#]+)$/)?.[1];
		if (matchedKey) storageKey = decodeURIComponent(matchedKey);
	} catch {}
	const src = storageKey
		? `/_emdash/api/media/file/${encodeURIComponent(storageKey)}`
		: rawSrc;
	const href = image.link || src;
	return [{
		...image,
		src,
		storageKey,
		href: typeof href === "string" && href.trim() ? href.trim() : src,
	}];
});
const columnCount = Math.max(1, Math.min(Number(columns) || 3, 4, safeImages.length || 1));
const imageSizes = `(max-width: 608px) calc(50vw - 1.5rem), ${Math.ceil(768 / columnCount)}px`;
---

{safeImages.length > 0 && (
	<div
		class:list={["yohaku-gallery", safeImages.length === 1 && "is-single"]}
		style={`--gallery-columns: ${columnCount}`}
		aria-label="記事内の写真"
	>
		{safeImages.map((image, index) => (
			<figure>
				<a href={image.href} target="_blank" rel="noopener" aria-label="画像を原寸で開く">
					<YohakuImage
						image={{
							id: image.storageKey || "",
							src: image.src,
							alt: image.alt || "",
							width: image.width,
							height: image.height,
							meta: image.storageKey ? { storageKey: image.storageKey } : undefined,
						}}
						preview={Boolean(image.storageKey)}
						priority={_yohakuPriority && index === 0}
						sizes={imageSizes}
					/>
				</a>
				{image.caption && <figcaption>{image.caption}</figcaption>}
			</figure>
		))}
	</div>
)}

<style>
	.yohaku-gallery {
		display: grid;
		grid-template-columns: repeat(var(--gallery-columns), minmax(0, 1fr));
		gap: clamp(0.55rem, 1.6vw, 1rem);
		margin: clamp(2rem, 5vw, 3rem) 0;
	}

	figure { margin: 0; min-width: 0; }
	a { display: block; color: inherit; }
	.yohaku-gallery :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		max-height: 78vh;
		border: 1px solid var(--color-border-subtle);
		background: var(--color-bg-subtle);
		object-fit: cover;
	}

	.yohaku-gallery.is-single :global(img) { height: auto; object-fit: contain; }
	figcaption {
		margin-top: 0.45rem;
		color: var(--color-muted);
		font-size: 0.76rem;
		line-height: 1.6;
	}

	@media (max-width: 38rem) {
		.yohaku-gallery:not(.is-single) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
</style>
